+// PreservesCompatibleResponsesReasoning is a trusted account policy, never a
+// request-body option. Only native OpenAI-compatible API-key Responses routes
+// may opt in; OAuth and Chat Completions fallback retain OpenAI normalization.
+func (a *Account) PreservesCompatibleResponsesReasoning() bool {
+	if a == nil || !a.IsOpenAIApiKey() || !openai_compat.ShouldUseResponsesAPI(a.Extra) {
+		return false
+	}
+	enabled, ok := a.Extra["openai_preserve_compatible_reasoning"].(bool)
+	return ok && enabled
+}
