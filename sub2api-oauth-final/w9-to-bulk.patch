+package repository
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"entgo.io/ent/dialect"
+	entsql "entgo.io/ent/dialect/sql"
+	sqlmock "github.com/DATA-DOG/go-sqlmock"
+	dbent "github.com/Wei-Shaw/sub2api/ent"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/stretchr/testify/require"
+)
+
+// Adapt SQL shape recorders to the real RETURNING cursor without weakening
+// any existing SQL/argument/value assertion. They remain unit shape checks.
+func oauthBulkRecordingSQL(t *testing.T, ids ...int64) *recordingSQLExecutor {
+	t.Helper()
+	db, mock, err := sqlmock.New()
+	require.NoError(t, err)
+	rows := sqlmock.NewRows([]string{"id"})
+	for _, id := range ids {
+		rows.AddRow(id)
+	}
+	mock.ExpectQuery(`(?s)^UPDATE accounts SET .* RETURNING id$`).WillReturnRows(rows).RowsWillBeClosed()
+	t.Cleanup(func() {
+		require.NoError(t, mock.ExpectationsWereMet())
+		mock.ExpectClose()
+		require.NoError(t, db.Close())
+	})
+	return &recordingSQLExecutor{result: rowsAffectedResult(len(ids)), queryDB: db}
+}
+
+// Inject failures at each cursor boundary: none may reach publication or commit.
+func TestOAuthBulkReturningCursorFailures(t *testing.T) {
+	for _, mode := range []string{"query", "scan", "iteration", "close"} {
+		t.Run(mode, func(t *testing.T) {
+			db, mock, err := sqlmock.New()
+			require.NoError(t, err)
+			client := dbent.NewClient(dbent.Driver(entsql.OpenDB(dialect.Postgres, db)))
+			t.Cleanup(func() { mock.ExpectClose(); require.NoError(t, client.Close()) })
+			mock.ExpectBegin()
+			q := mock.ExpectQuery(`(?s)^UPDATE accounts SET .* RETURNING id$`)
+			injected := errors.New("synthetic cursor failure")
+			switch mode {
+			case "query":
+				q.WillReturnError(injected)
+			case "scan":
+				q.WillReturnRows(sqlmock.NewRows([]string{"id"}).AddRow("invalid-id")).RowsWillBeClosed()
+			case "iteration":
+				q.WillReturnRows(sqlmock.NewRows([]string{"id"}).AddRow(int64(27)).RowError(0, injected)).RowsWillBeClosed()
+			case "close":
+				q.WillReturnRows(sqlmock.NewRows([]string{"id"}).CloseError(injected)).RowsWillBeClosed()
+			}
+			mock.ExpectRollback()
+			name := "synthetic"
+			n, err := newAccountRepositoryWithSQL(client, db, nil).BulkUpdate(context.Background(), []int64{27}, service.AccountBulkUpdate{Name: &name})
+			require.Error(t, err)
+			require.Zero(t, n)
+			if mode != "scan" {
+				require.ErrorIs(t, err, injected)
+			}
+			require.NoError(t, mock.ExpectationsWereMet())
+		})
+	}
+}
