+// Actual PostgreSQL RETURNING controls cover zero publication and deterministic
+// input ordering/deduplication even when every native document is permitted.
+func TestOAuthBulkAffectedIDsControls(t *testing.T) {
+	s := oauthLabSetup(t)
+	for _, mode := range []string{"zero", "all", "mixed_missing"} {
+		t.Run(mode, func(t *testing.T) {
+			f := s.fixture(t)
+			native := f.row()
+			native.Type = service.AccountTypeAPIKey
+			native.Credentials = map[string]any{"api_key": "synthetic-native"}
+			oauthLabNeed(t, s.repo.Update(f.ctx, native) == nil, "native control setup failed")
+			sibling := oauthForkAlias(f)
+			sibling.Type = service.AccountTypeAPIKey
+			sibling.Credentials = map[string]any{"api_key": "synthetic-sibling"}
+			oauthLabNeed(t, s.repo.Update(f.ctx, sibling) == nil, "sibling control setup failed")
+			beforeN := f.row()
+			beforeS, err := s.repo.GetByID(f.ctx, sibling.ID)
+			oauthLabNeed(t, err == nil, "control sibling reread failed")
+			targets := []int64{-native.ID, -sibling.ID, -native.ID}
+			var expected []int64
+			if mode == "all" {
+				targets = []int64{sibling.ID, native.ID, sibling.ID, native.ID}
+				expected = []int64{sibling.ID, native.ID}
+			}
+			if mode == "mixed_missing" {
+				targets = []int64{-sibling.ID, native.ID, -sibling.ID, native.ID}
+				expected = []int64{native.ID}
+			}
+			observer := oauthBulkObserve(t, f, []int64{native.ID, sibling.ID})
+			repo, _ := oauthW9Repository(t, f, fmt.Sprintf("bulk_control_%d", native.ID))
+			repo.schedulerCache = observer
+			status := service.StatusDisabled
+			credentials := map[string]any{"client_id": map[string]any{"native": "permitted"}, "business_field": true}
+			n, e := repo.BulkUpdate(f.ctx, targets, service.AccountBulkUpdate{Credentials: credentials, Status: &status})
+			f.check(e == nil && n == int64(len(expected)), "actual affected-row count failed")
+			oauthBulkAssertEffects(t, f, observer, []int64{native.ID, sibling.ID}, expected, 0)
+			for _, before := range []*service.Account{beforeN, beforeS} {
+				after, e := s.repo.GetByID(f.ctx, before.ID)
+				oauthLabNeed(t, e == nil, "control final reread failed")
+				updated := false
+				for _, id := range expected {
+					updated = updated || id == before.ID
+				}
+				want := copyJSONMap(before.Credentials)
+				if updated {
+					for k, v := range credentials {
+						want[k] = v
+					}
+				}
+				f.check(reflect.DeepEqual(after.Credentials, oauthW9JSONValue(t, want)) && service.OAuthRevision(after) == service.OAuthRevision(before), "control document/revision failed")
+				if updated {
+					f.check(after.Status == status, "updated native status unchanged")
+				} else {
+					f.check(after.Status == before.Status, "excluded native status changed")
