+func (f *oauthLabFixture) safeResult(e oauthLabEvent, phase string) {
+	if e.Error || e.Denied {
+		f.check(e.HTTPStatus == 0 && (e.Phase == "empty" || e.Phase == ""), "protected denial must not send any bearer")
+		return
+	}
+	f.accepted(e, phase)
+}
