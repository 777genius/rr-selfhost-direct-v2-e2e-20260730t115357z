+func oauthW9Write(ctx context.Context, repo *accountRepository, operation string, id int64, credentials map[string]any) oauthW9WriteResult {
+	if operation == "BulkUpdate" {
+		n, err := repo.BulkUpdate(ctx, []int64{id}, service.AccountBulkUpdate{Credentials: credentials})
+		return oauthW9WriteResult{n, err}
+	}
+	err := repo.UpdateCredentials(ctx, id, credentials)
+	if err != nil {
+		return oauthW9WriteResult{0, err}
+	}
+	return oauthW9WriteResult{1, nil}
