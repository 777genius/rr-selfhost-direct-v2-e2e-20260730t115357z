+						for _, statement := range []string{"DROP TRIGGER IF EXISTS z_" + suffix + "_before ON accounts", "DROP TRIGGER IF EXISTS z_" + suffix + "_after ON accounts", "DROP FUNCTION IF EXISTS " + function + "()", "DROP TABLE IF EXISTS " + table} {
+							_, e := s.db.ExecContext(ctx, statement)
