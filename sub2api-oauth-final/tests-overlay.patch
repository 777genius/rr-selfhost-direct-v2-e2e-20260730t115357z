+package admin
+
+import (
+	"context"
+	"testing"
+)
+
+// Actual import normalization must not stringify or silently discard invalid
+// identity fields before the central admin/repository write guard can see them.
+func TestOAuthForkW7ImportIdentityTypes(t *testing.T) {
+	for _, key := range []string{"client_id", "refresh_token", "clientId", "refreshToken"} {
+		for _, nested := range []bool{false, true} {
+			for _, value := range []any{123, true, []any{"synthetic"}, map[string]any{"x": "synthetic"}} {
+				raw := map[string]any{"access_token": "synthetic-access"}
+				if nested {
+					raw["tokens"] = map[string]any{key: value}
+				} else {
+					raw[key] = value
+				}
+				if item, err := normalizeCodexImportEntry(codexImportEntry{Index: 1, Value: raw}); err == nil || item != nil {
+					t.Fatal("import coerced or ignored unsupported identity type")
+				}
+			}
+		}
+	}
+	// A nil service is deliberate: invalid extras must fail before any repository
+	// lookup, create/update, privacy request, or provider operation is attempted.
+	h := &AccountHandler{}
+	for _, key := range []string{"client_id", "refresh_token"} {
+		if _, err := h.importCodexSessions(context.Background(), CodexSessionImportRequest{CredentialExtras: map[string]any{key: true}}, nil); err == nil {
+			t.Fatal("malformed import extras accepted")
+		}
+	}
+	item, err := normalizeCodexImportEntry(codexImportEntry{Index: 1, Value: map[string]any{"access_token": "synthetic-access", "refresh_token": " exact refresh bytes ", "client_id": nil, "native_business": map[string]any{"x": true}}})
+	if err != nil || item.Credentials["refresh_token"] != " exact refresh bytes " {
+		t.Fatal("valid import changed refresh-token wire bytes")
+	}
+}
