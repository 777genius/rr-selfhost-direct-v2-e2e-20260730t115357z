+// An actual Forward transport boundary. Only the destination is redirected to
+// an isolated synthetic HTTP server; production request building, header/auth
+// selection, proxy handoff and response parsing run unchanged. No HTTP response
+// or credential is supplied by a repository/provider mock.
+type oauthForkWire struct {
+	client        *http.Client
+	target        *url.URL
+	mu            sync.Mutex
+	calls         int
+	proxy         string
+	authorization string
+	identity      string
+	fedramp       string
+	accountID     int64
+}
+
+func (u *oauthForkWire) Do(req *http.Request, proxy string, accountID int64, _ int) (*http.Response, error) {
+	u.mu.Lock()
+	u.calls++
+	u.proxy = proxy
+	u.authorization = req.Header.Get("Authorization")
+	u.identity = req.Header.Get("chatgpt-account-id")
+	u.fedramp = req.Header.Get("x-openai-fedramp")
+	u.accountID = accountID
+	u.mu.Unlock()
+	copy := req.Clone(req.Context())
+	destination := *u.target
+	copy.URL = &destination
+	copy.Host = destination.Host
+	return u.client.Do(copy)
+}
+func (u *oauthForkWire) DoWithTLS(req *http.Request, proxy string, id int64, c int, _ *tlsfingerprint.Profile) (*http.Response, error) {
+	return u.Do(req, proxy, id, c)
+}
