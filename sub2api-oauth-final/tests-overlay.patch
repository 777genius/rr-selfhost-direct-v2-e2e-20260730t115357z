+// This fixture tests the service's manual HTTP boundary, not PostgreSQL. The
+// companion oauthlab validation_cas_reconnect case executes the actual DB CAS.
+type oauthForkManualRepo struct {
+	AccountRepository
+	OpenAIOAuthDurableRepository
+	mu      sync.Mutex
+	account *Account
+	saves   int
+}
+
+func (r *oauthForkManualRepo) LoadOAuthState(context.Context, int64) (*Account, bool, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	a, err := cloneOAuthExecutionAccount(r.account)
+	return a, false, err
+}
+func (r *oauthForkManualRepo) SaveOAuthValidation(_ context.Context, expected *Account, credentials map[string]any) (*Account, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if OAuthRevision(expected) != OAuthRevision(r.account) || !reflect.DeepEqual(expected.Credentials, r.account.Credentials) {
+		return nil, errors.New("synthetic metadata CAS conflict")
+	}
+	r.saves++
+	r.account.Credentials = credentials
+	return cloneOAuthExecutionAccount(r.account)
+}
+func TestOAuthForkManualValidationHTTP(t *testing.T) {
+	for _, kind := range []string{"valid_pat", "invalid_pat", "reconnect_during_pat", "access_only_enrichment"} {
+		t.Run(kind, func(t *testing.T) {
+			a := &Account{ID: 41, Platform: PlatformOpenAI, Type: AccountTypeOAuth, Status: StatusActive, Schedulable: true,
+				Credentials: map[string]any{"access_token": "at-fabricated-manual", "auth_mode": OpenAIAuthModePersonalAccessToken, "_oauth_revision": "1", "model_mapping": map[string]any{"a": "b"}}}
+			if kind == "access_only_enrichment" {
+				a.Credentials["access_token"] = "fabricated-access-only"
+				delete(a.Credentials, "auth_mode")
+			}
+			repo := &oauthForkManualRepo{account: a}
+			before, _ := json.Marshal(a.Credentials)
+			var whoami, checks, privacy, refreshPosts atomic.Int64
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				if r.Method == http.MethodPost {
+					refreshPosts.Add(1)
+					w.WriteHeader(400)
+					return
+				}
+				if r.URL.Path == "/whoami" {
+					whoami.Add(1)
+					if r.Method != http.MethodGet || r.Header.Get("Authorization") != "Bearer "+"at-fabricated-manual" {
+						w.WriteHeader(400)
+						return
+					}
+					if kind == "invalid_pat" {
+						w.WriteHeader(http.StatusUnauthorized)
+						return
+					}
+					if kind == "reconnect_during_pat" {
+						repo.mu.Lock()
+						repo.account.Credentials["access_token"] = "at-fabricated-replacement"
+						repo.account.Credentials["_oauth_revision"] = "2"
+						repo.mu.Unlock()
+					}
+					_, _ = io.WriteString(w, `{"email":"validated@synthetic.invalid","chatgpt_user_id":"validated-user","chatgpt_account_id":"validated-account","chatgpt_plan_type":"plus","chatgpt_account_is_fedramp":true}`)
+					return
+				}
+				if r.Header.Get("Authorization") != "Bearer "+"fabricated-access-only" {
+					w.WriteHeader(401)
+					return
+				}
+				if r.Method == http.MethodPatch {
+					privacy.Add(1)
+					_, _ = io.WriteString(w, `{}`)
+					return
+				}
+				checks.Add(1)
+				_, _ = io.WriteString(w, `{"accounts":{"synthetic":{"account":{"account_id":"synthetic","is_default":true,"plan_type":"plus"},"entitlement":{"subscription_plan":"plus","expires_at":"2099-01-01T00:00:00Z"}}}}`)
+			}))
+			defer server.Close()
+			oldURL := openAICodexPATWhoamiURL
+			openAICodexPATWhoamiURL = server.URL + "/whoami"
+			defer func() { openAICodexPATWhoamiURL = oldURL }()
+			oauth := NewOpenAIOAuthService(nil, nil)
+			defer oauth.Stop()
+			target, _ := url.Parse(server.URL)
+			oauth.SetPrivacyClientFactory(func(string) (*req.Client, error) {
+				return req.C().WrapRoundTripFunc(func(rt req.RoundTripper) req.RoundTripFunc {
+					return func(r *req.Request) (*req.Response, error) {
+						r.URL.Scheme = target.Scheme
+						r.URL.Host = target.Host
+						return rt.RoundTrip(r)
+					}
+				}), nil
+			})
+			result, err := RefreshOpenAIAccount(context.Background(), repo, oauth, a)
+			if kind == "invalid_pat" || kind == "reconnect_during_pat" {
+				if err == nil || result != nil || repo.saves != 0 || whoami.Load() != 1 {
+					t.Fatal("invalid PAT or concurrent reconnect must fail without persisting metadata")
+				}
+				if kind == "invalid_pat" {
+					after, _ := json.Marshal(repo.account.Credentials)
+					if string(before) != string(after) {
+						t.Fatal("invalid validation changed credentials")
+					}
+				}
+				if kind == "reconnect_during_pat" && repo.account.GetOpenAIAccessToken() != "at-fabricated-replacement" {
+					t.Fatal("reconnect lost")
+				}
+			} else {
+				if err != nil || result == nil || repo.saves != 1 {
+					t.Fatal("explicit manual intent must validate/enrich and save once")
+				}
+				if result.GetCredential("refresh_token") != "" || refreshPosts.Load() != 0 {
+					t.Fatal("nonrotating manual operation POSTed or invented refresh material")
+				}
+				if kind == "valid_pat" && (whoami.Load() != 1 || result.GetCredential("email") != "validated@synthetic.invalid" || result.GetChatGPTAccountID() != "validated-account" || !result.IsChatGPTAccountFedRAMP()) {
+					t.Fatal("validated PAT metadata missing")
+				}
+				if kind == "access_only_enrichment" && (whoami.Load() != 0 || checks.Load() == 0 || privacy.Load() != 1 || result.GetCredential("plan_type") != "plus") {
+					t.Fatal("access-only operation must use real enrichment HTTP and preserve its bearer")
+				}
+				if !reflect.DeepEqual(result.Credentials["model_mapping"], map[string]any{"a": "b"}) {
+					t.Fatal("manual metadata write lost local credential document settings")
+				}
+			}
+		})
+	}
+}
