+						status := service.StatusDisabled
+						n, e := repoA.BulkUpdate(ctx, targets, service.AccountBulkUpdate{Credentials: invalid, Status: &status})
+						aResult <- oauthW9WriteResult{n, e}
+					}()
+					oauthW9Blocked(t, f, pidA, pidB, appA, true)
+					f.barriers = append(f.barriers, "actual_management_update_blocked_behind_admin_conversion")
