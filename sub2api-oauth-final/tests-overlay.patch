+// Pause only after an actual cache read returns. The parent mutates PostgreSQL
+// during this I/O window; this hook supplies no token or eligibility decision.
+type oauthLabCacheReadBarrier struct {
+	mu    sync.Mutex
+	gate  chan struct{}
+	armed bool
+	emit  func(oauthLabEvent)
+}
+
+func (h *oauthLabCacheReadBarrier) arm() {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.gate = make(chan struct{})
+	h.armed = true
+}
+func (h *oauthLabCacheReadBarrier) release() {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.gate != nil {
+		close(h.gate)
+		h.gate = nil
+	}
+}
+func (h *oauthLabCacheReadBarrier) DialHook(next redis.DialHook) redis.DialHook { return next }
