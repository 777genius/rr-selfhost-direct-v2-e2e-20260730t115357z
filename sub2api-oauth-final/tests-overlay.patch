+// Multiplex actual contention/protected denial with actual issuer entry. The
+// predecessor reply is released by the caller immediately after this barrier.
+// An unexpected second request is recorded as a regression and released so
+// cleanup cannot hide it behind a deadlock/timeout.
+func (f *oauthLabFixture) contenderBarrier(p *oauthLabProcess) {
+	f.t.Helper()
+	observed := func(e oauthLabEvent) bool {
+		return e.Kind == "pg_contended" || e.Kind == "lock_contended" || e.Kind == "result" && (e.Error || e.Denied) && e.HTTPStatus == 0
+	}
+	for _, e := range p.pending {
+		if observed(e) {
+			return
+		}
+	}
+	for {
+		select {
+		case a := <-f.issuer.entered:
+			f.check(false, "unexpected second issuer request while another rotation is pending")
+			a.release()
+			return
+		case e, ok := <-p.events:
+			if !ok {
+				f.t.Fatal("contender exited without actual contention or protected denial")
+			}
+			p.transcript = append(p.transcript, e)
+			p.pending = append(p.pending, e)
+			if observed(e) {
+				return
+			}
+		case <-f.ctx.Done():
+			f.t.Fatal("no independent contender outcome within bound")
+		}
+	}
+}
