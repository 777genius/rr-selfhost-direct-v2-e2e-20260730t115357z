+func oauthW6Gateway(f *oauthLabFixture, tokenURL string, upstream service.HTTPUpstream) *service.OpenAIGatewayService {
+	oauth := service.NewOpenAIOAuthService(nil, &openaiOAuthService{tokenURL: tokenURL})
+	f.t.Cleanup(oauth.Stop)
+	tokens := NewGeminiTokenCache(f.suite.rdb)
+	api := service.NewOAuthRefreshAPI(f.suite.repo, tokens)
+	provider := service.NewOpenAITokenProvider(f.suite.repo, tokens, oauth)
+	provider.SetRefreshAPI(api, service.NewOpenAITokenRefresher(oauth, f.suite.repo))
+	cfg := &config.Config{}
+	cfg.Security.URLAllowlist.Enabled = false
+	cfg.Security.URLAllowlist.AllowInsecureHTTP = true
+	cfg.Gateway.OpenAIWS.Enabled = true
+	cfg.Gateway.OpenAIWS.OAuthEnabled = true
+	cfg.Gateway.OpenAIWS.ResponsesWebsocketsV2 = true
+	cfg.Gateway.OpenAIWS.ModeRouterV2Enabled = true
+	cfg.Gateway.OpenAIWS.IngressModeDefault = service.OpenAIWSIngressModeCtxPool
+	return service.NewOpenAIGatewayService(f.suite.repo, nil, nil, nil, nil, nil, nil, cfg, nil, nil, nil, nil, nil, upstream, nil, provider, nil, nil, nil, nil, nil, nil)
+}
+
+// Real proxy allows the synthetic issuer's HTTP request but trips any WS dial.
+func oauthW6Proxy(f *oauthLabFixture) (*service.Proxy, *atomic.Int64) {
+	var connects atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodConnect {
+			connects.Add(1)
+			w.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		// Confine forwarding to the fixture issuer; never a provider endpoint.
+		if r.URL.Host != strings.TrimPrefix(f.issuer.server.URL, "http://") {
+			connects.Add(1)
+			w.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		req := r.Clone(r.Context())
+		req.RequestURI = ""
+		resp, err := f.issuer.server.Client().Do(req)
+		if err != nil {
+			w.WriteHeader(http.StatusBadGateway)
+			return
+		}
+		defer resp.Body.Close()
+		for k, v := range resp.Header {
+			w.Header()[k] = v
+		}
+		w.WriteHeader(resp.StatusCode)
+		_, _ = io.Copy(w, resp.Body)
+	}))
+	f.t.Cleanup(server.Close)
+	target, _ := url.Parse(server.URL)
+	proxy := &service.Proxy{Name: "synthetic-w6-tripwire", Protocol: "http", Host: target.Hostname(), Port: server.Listener.Addr().(*net.TCPAddr).Port, Status: service.StatusActive}
+	oauthLabNeed(f.t, NewProxyRepository(f.suite.client, f.suite.db).Create(f.ctx, proxy) == nil, "real proxy setup failed")
+	f.t.Cleanup(func() {
+		_, _ = f.suite.db.ExecContext(context.Background(), "DELETE FROM proxies WHERE id=$1", proxy.ID)
+	})
+	row := f.row()
+	row.ProxyID = &proxy.ID
+	oauthLabNeed(f.t, f.suite.repo.Update(f.ctx, row) == nil, "proxy attachment failed")
+	return proxy, &connects
+}
