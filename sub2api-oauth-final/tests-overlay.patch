+		result <- g.ProxyResponsesWebSocketFromClient(ctx, c, conn, account, token, []byte(`{"type":"response.create","model":"gpt-5.4","input":"synthetic"}`), hooks)
+	}))
+	defer downstream.Close()
+	conn, _, err := coderws.Dial(f.ctx, "ws"+strings.TrimPrefix(downstream.URL, "http"), nil)
+	if err != nil {
+		return err
+	}
+	defer conn.CloseNow()
+	select {
+	case err = <-result:
+		return err
+	case <-f.ctx.Done():
+		return f.ctx.Err()
