+// Only the test SQL adapter pauses. It delegates all query results to actual
+// PostgreSQL and leaves production hydration and retry logic unchanged.
+type oauthW6ValidationBoundary struct {
+	*sql.DB
+	once     sync.Once
+	hydrated chan struct{}
+	resume   chan struct{}
+}
+
+func (b *oauthW6ValidationBoundary) QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error) {
+	if strings.Contains(query, "SELECT EXISTS (SELECT 1 FROM openai_oauth_consumption p") {
+		var err error
+		b.once.Do(func() {
+			close(b.hydrated)
+			select {
+			case <-b.resume:
+			case <-ctx.Done():
+				err = ctx.Err()
+			}
+		})
+		if err != nil {
+			return nil, err
+		}
+	}
+	return b.DB.QueryContext(ctx, query, args...)
+}
