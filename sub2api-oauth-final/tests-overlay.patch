+				t.Error("metadata must contain every scheduler allowlisted field and the exact revision only")
+			}
+			after, err := json.Marshal(credentials)
+			if err != nil || string(before) != string(after) {
+				t.Error("metadata serialization changed the source credentials")
+			}
+		})
