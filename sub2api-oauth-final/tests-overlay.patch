+					})
+					ddl := fmt.Sprintf(`CREATE FUNCTION %s() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+      IF OLD.id=%d AND OLD.type='apikey' AND NEW.type='oauth' THEN
+       IF TG_WHEN='BEFORE' THEN PERFORM pg_advisory_xact_lock(%d::bigint);
+       ELSE INSERT INTO %s VALUES (NEW.credentials,NEW.oauth_revision); END IF;
+      END IF; RETURN NEW; END $$`, function, native.ID, lockID, table)
+					_, err = s.db.ExecContext(f.ctx, ddl)
+					oauthLabNeed(t, err == nil, "barrier function setup failed")
