+//go:build oauthlab
+
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"reflect"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/service"
+	"github.com/lib/pq"
+)
+
+// Observe the real repository's immediate scheduler adapter boundary. No Redis
+// mutation is simulated or claimed; all mutation and outbox SQL is real.
+type oauthBulkCacheObserver struct {
+	service.SchedulerCache
+	db        *sql.DB
+	watermark int64
+	mu        sync.Mutex
+	ids       []int64
+	committed bool
+}
+
+func (c *oauthBulkCacheObserver) SetAccount(ctx context.Context, a *service.Account) error {
+	var committed bool
+	err := c.db.QueryRowContext(ctx, `SELECT EXISTS (
+ SELECT 1 FROM accounts a JOIN scheduler_outbox o ON
+ o.event_type=$2 AND o.id>$3 AND o.payload->'account_ids' @> jsonb_build_array(a.id)
+ WHERE a.id=$1 AND a.status=$4 AND a.credentials=$5::jsonb)`, a.ID,
+		service.SchedulerOutboxEventAccountBulkChanged, c.watermark, a.Status, mustOAuthBulkJSON(a.Credentials)).Scan(&committed)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.ids = append(c.ids, a.ID)
+	c.committed = c.committed && err == nil && committed
+	return err
+}
+
+func (c *oauthBulkCacheObserver) DeleteAccount(_ context.Context, id int64) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.ids = append(c.ids, id)
+	c.committed = false
+	return nil
+}
+
+func mustOAuthBulkJSON(v any) []byte {
+	b, err := json.Marshal(v)
+	if err != nil {
+		panic("synthetic JSON encode failed")
+	}
+	return b
+}
+
+const oauthBulkOwnedOutbox = `(account_id=ANY($1) OR EXISTS (
+ SELECT 1 FROM jsonb_array_elements_text(COALESCE(payload->'account_ids','[]'::jsonb)) AS target(id)
+ WHERE target.id::bigint=ANY($1)))`
+
+type oauthBulkEvent struct {
+	kind    string
+	account sql.NullInt64
+	ids     []int64
+}
+
+func oauthBulkEvents(t *testing.T, f *oauthLabFixture, targets []int64, watermark int64) []oauthBulkEvent {
+	t.Helper()
+	rows, err := f.suite.db.QueryContext(f.ctx, "SELECT event_type,account_id,payload FROM scheduler_outbox WHERE "+oauthBulkOwnedOutbox+" AND id>$2 ORDER BY id", pq.Array(targets), watermark)
+	oauthLabNeed(t, err == nil, "real outbox query failed")
+	defer rows.Close()
+	var events []oauthBulkEvent
+	for rows.Next() {
+		var e oauthBulkEvent
+		var payload []byte
+		oauthLabNeed(t, rows.Scan(&e.kind, &e.account, &payload) == nil, "real outbox scan failed")
+		if len(payload) > 0 {
+			var v struct {
+				IDs []int64 `json:"account_ids"`
+			}
+			oauthLabNeed(t, json.Unmarshal(payload, &v) == nil, "real outbox decode failed")
+			e.ids = v.IDs
+		}
+		events = append(events, e)
+	}
+	oauthLabNeed(t, rows.Err() == nil, "real outbox cursor failed")
+	oauthLabNeed(t, rows.Close() == nil, "real outbox cursor close failed")
+	return events
+}
+
+// Remove only events for this fixture's IDs; leave unrelated rows/services alone.
+// Purging setup dedup records also makes B's own admin publication observable.
+func oauthBulkObserve(t *testing.T, f *oauthLabFixture, targets []int64) *oauthBulkCacheObserver {
+	t.Helper()
+	_, err := f.suite.db.ExecContext(f.ctx, "DELETE FROM scheduler_outbox WHERE "+oauthBulkOwnedOutbox, pq.Array(targets))
+	oauthLabNeed(t, err == nil, "owned setup outbox purge failed")
+	var watermark int64
+	err = f.suite.db.QueryRowContext(f.ctx, "SELECT COALESCE(max(id),0) FROM scheduler_outbox").Scan(&watermark)
+	oauthLabNeed(t, err == nil, "outbox watermark failed")
+	t.Cleanup(func() {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		_, e := f.suite.db.ExecContext(ctx, "DELETE FROM scheduler_outbox WHERE "+oauthBulkOwnedOutbox, pq.Array(targets))
+		oauthLabNeed(t, e == nil, "owned bulk outbox cleanup failed")
+	})
+	return &oauthBulkCacheObserver{db: f.suite.db, watermark: watermark, committed: true}
+}
+
+func oauthBulkAssertEffects(t *testing.T, f *oauthLabFixture, observer *oauthBulkCacheObserver, targets, expected []int64, converted int64) {
+	t.Helper()
+	events := oauthBulkEvents(t, f, targets, observer.watermark)
+	var bulk [][]int64
+	admin := 0
+	for _, e := range events {
+		if e.kind == service.SchedulerOutboxEventAccountBulkChanged {
+			bulk = append(bulk, e.ids)
+		}
+		if e.kind == service.SchedulerOutboxEventAccountChanged && e.account.Valid && e.account.Int64 == converted {
+			admin++
+		}
+	}
+	if len(expected) == 0 {
+		f.check(len(bulk) == 0, "zero updated rows published a bulk event")
+	} else {
+		f.check(len(bulk) == 1 && reflect.DeepEqual(bulk[0], expected), "bulk event IDs differ from actual updated rows/order")
+	}
+	// B's conversion is independently entitled to its trigger + admin events.
+	// It must not be confused with A's bulk publication.
+	if converted != 0 {
+		f.check(admin == 2, "B conversion trigger/admin publications missing or duplicated")
+	}
+	observer.mu.Lock()
+	actual := append([]int64(nil), observer.ids...)
+	committed := observer.committed
+	observer.mu.Unlock()
+	want := append([]int64(nil), expected...)
+	sort.Slice(actual, func(i, j int) bool { return actual[i] < actual[j] })
+	sort.Slice(want, func(i, j int) bool { return want[i] < want[j] })
+	f.check(reflect.DeepEqual(actual, want), "immediate cache effect IDs differ from actual updated rows")
+	f.check(committed, "cache adapter ran before account/outbox commit or changed an excluded row")
+	evidence, _ := json.Marshal(map[string]any{"case_id": t.Name(), "bulk_event_ids": bulk, "cache_effect_ids": actual, "cache_boundary": "repository SetAccount observer; no Redis writes", "cache_after_commit": committed, "b_own_account_changed_events": admin})
+	t.Log("OAUTH_BULK_EFFECTS " + string(evidence))
+}
+func TestOAuthBulkAffectedIDsConversionConcurrency(t *testing.T) {
+	s := oauthLabSetup(t)
+	for _, operation := range []string{"BulkUpdate"} {
+		for _, key := range []string{"client_id", "refresh_token"} {
+			for _, tc := range oauthW7Types() {
+				t.Run(operation+"/"+key+"/"+tc.name, func(t *testing.T) {
+					f := s.fixture(t)
+					native := f.row()
+					native.Type = service.AccountTypeAPIKey
+					native.Credentials = map[string]any{"api_key": "synthetic-native"}
+					oauthLabNeed(t, s.repo.Update(f.ctx, native) == nil, "native target setup failed")
+					healthy := oauthForkAlias(f)
+					healthy.Credentials = f.issuer.credentials(true)
+					healthy.Credentials["refresh_token"] = f.issuer.token("REAUTH_REFRESH") + "-sibling"
+					oauthLabNeed(t, s.repo.Update(f.ctx, healthy) == nil, "healthy sibling setup failed")
+					healthyBefore, err := s.repo.GetByID(f.ctx, healthy.ID)
+					oauthLabNeed(t, err == nil, "sibling reread failed")
+					allowed := oauthForkAlias(f)
+					allowed.Type = service.AccountTypeAPIKey
+					allowed.Credentials = map[string]any{"api_key": "synthetic-allowed-native"}
+					oauthLabNeed(t, s.repo.Update(f.ctx, allowed) == nil, "allowed native setup failed")
+					allowedBefore, err := s.repo.GetByID(f.ctx, allowed.ID)
+					oauthLabNeed(t, err == nil, "allowed native reread failed")
+					targets := []int64{native.ID, allowed.ID, native.ID, allowed.ID}
+					observer := oauthBulkObserve(t, f, []int64{native.ID, allowed.ID, healthy.ID})
+					suffix := fmt.Sprintf("bulk_%d", native.ID)
+					appA, appB := suffix+"_a", suffix+"_b"
+					repoA, pidA := oauthW9Repository(t, f, appA)
+					repoB, pidB := oauthW9Repository(t, f, appB)
+					repoA.schedulerCache = observer
+					gate, err := s.db.Conn(f.ctx)
+					oauthLabNeed(t, err == nil, "barrier connection failed")
