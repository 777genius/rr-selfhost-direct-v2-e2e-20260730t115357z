+func TestOAuthForkEmptyRefreshHTTPBoundary(t *testing.T) {
+	var posts atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		posts.Add(1)
+		_ = r.ParseForm()
+		if r.Method != http.MethodPost || r.Form.Get("grant_type") != "refresh_token" || r.Form.Get("refresh_token") != "fabricated-refresh" || r.Form.Get("client_id") != "fabricated-client" {
+			w.WriteHeader(400)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"access_token":"fabricated-successor","refresh_token":"fabricated-next","expires_in":3600,"token_type":"Bearer"}`)
+	}))
+	defer server.Close()
+	oauth := &openaiOAuthService{tokenURL: server.URL}
+	result, err := oauth.RefreshTokenWithClientID(context.Background(), " \t ", "", "fabricated-client")
+	if err == nil || result != nil || posts.Load() != 0 {
+		t.Fatal("empty refresh token must fail before actual issuer HTTP")
+	}
+	result, err = oauth.RefreshTokenWithClientID(context.Background(), "fabricated-refresh", "", "fabricated-client")
+	if err != nil || result == nil || result.AccessToken != "fabricated-successor" || posts.Load() != 1 {
+		t.Fatal("HTTP control must traverse actual issuer POST/parser exactly once")
+	}
