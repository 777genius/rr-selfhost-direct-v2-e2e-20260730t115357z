+	for {
+		var blocked bool
+		err := f.suite.db.QueryRowContext(f.ctx, `SELECT EXISTS (
+   SELECT 1 FROM pg_stat_activity WHERE pid=$1 AND application_name=$3
+   AND $2=ANY(pg_blocking_pids(pid)) AND wait_event_type='Lock'
+   AND (NOT $4 OR query ILIKE '%UPDATE%accounts%'))`, waiter, blocker, app, mutation).Scan(&blocked)
+		oauthLabNeed(t, err == nil, "lock dependency observation failed")
+		if blocked {
+			return
+		}
+		select {
+		case <-f.ctx.Done():
+			t.Fatal("required PostgreSQL blocking dependency was not observed")
+		case <-ticker.C:
+		}
+	}
