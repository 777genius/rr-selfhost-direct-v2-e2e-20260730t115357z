+func TestOAuthForkWSReuseCredentialTuple(t *testing.T) {
+	a := &Account{Platform: PlatformOpenAI, Type: AccountTypeOAuth, Credentials: map[string]any{"_oauth_revision": "1"}, Proxy: &Proxy{Protocol: "http", Host: "127.0.0.1", Port: 8001}}
+	old := http.Header{"Authorization": []string{"Bearer fabricated-old"}, "Chatgpt-Account-Id": []string{"old"}}
+	key := normalizeOpenAIWSHandshakeCompatibility(a, old)
+	for _, kind := range []string{"bearer", "identity", "fedramp", "proxy", "revision"} {
+		t.Run(kind, func(t *testing.T) {
+			b, _ := cloneOAuthExecutionAccount(a)
+			headers := old.Clone()
+			switch kind {
+			case "bearer":
+				headers.Set("Authorization", "Bearer fabricated-new")
+			case "identity":
+				headers.Set("chatgpt-account-id", "new")
+			case "fedramp":
+				headers.Set("x-openai-fedramp", "true")
+			case "proxy":
+				b.Proxy.Port++
+			case "revision":
+				b.Credentials["_oauth_revision"] = "2"
+			}
+			if normalizeOpenAIWSHandshakeCompatibility(b, headers) == key {
+				t.Fatal("websocket connection reuse must reject a different credential/routing/auth tuple")
+			}
+		})
+	}
+}
