+		args := cmd.Args()
+		read := len(args) > 1 && ((cmd.Name() == "eval" && strings.Contains(fmt.Sprint(args[1]), "local prefix=ARGV[1]")) || (cmd.Name() == "get" && strings.HasPrefix(fmt.Sprint(args[1]), oauthTokenKeyPrefix)))
