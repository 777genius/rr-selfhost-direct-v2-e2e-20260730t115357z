+		e := f.request(p2, "new_work", true)
+		f.check(e.Denied && e.HTTPStatus == 0, "consumed uncertain refresh must deny subsequent gateway work")
+		f.counts(1, 1) // Any automatic issuer retry with consumed R0 makes this red.
+	})
