+-- PostgreSQL is the only refresh ownership domain. No lease/expiry can replay
+-- a claimed token. Keep attempt history through disable/re-enable and deletion.
+ALTER TABLE accounts ADD COLUMN oauth_revision bigint NOT NULL DEFAULT 1 CHECK (oauth_revision > 0);
+CREATE TABLE account_oauth_refresh_attempts (
+    account_id bigint NOT NULL,
+    revision bigint NOT NULL,
+    owner text NOT NULL,
+    state text NOT NULL CHECK (state IN ('pending', 'completed', 'terminal')),
+    expected_credentials jsonb NOT NULL,
+    result_credentials jsonb,
+    completion_revision bigint,
+    created_at timestamptz NOT NULL DEFAULT now(),
+    PRIMARY KEY (account_id, revision),
+    UNIQUE (owner)
+);
+CREATE TABLE account_oauth_tombstones (account_id bigint PRIMARY KEY, revision bigint NOT NULL);
+CREATE INDEX account_oauth_pending ON account_oauth_refresh_attempts(account_id)
+    WHERE state IN ('pending', 'terminal');
+
+-- The string projection lets the existing Ent credentials mapping carry an
+-- exact DB-assigned revision without generated-ORM changes or client clocks.
+UPDATE accounts SET credentials = jsonb_set(credentials, '{_oauth_revision}', '"1"')
+    WHERE platform = 'openai' AND type = 'oauth';
+CREATE FUNCTION fence_openai_oauth_account() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP = 'INSERT' THEN
+        NEW.oauth_revision := 1;
+    ELSE
+        NEW.oauth_revision := OLD.oauth_revision;
+        IF (OLD.platform = 'openai' AND OLD.type = 'oauth') OR
+           (NEW.platform = 'openai' AND NEW.type = 'oauth') THEN
+            IF (to_jsonb(NEW) - ARRAY['oauth_revision','credentials','updated_at','last_used_at','created_at'])
+                IS DISTINCT FROM
+               (to_jsonb(OLD) - ARRAY['oauth_revision','credentials','updated_at','last_used_at','created_at'])
+               OR (NEW.credentials - '_oauth_revision') IS DISTINCT FROM (OLD.credentials - '_oauth_revision') THEN
+                NEW.oauth_revision := OLD.oauth_revision + 1;
+            END IF;
+        END IF;
+    END IF;
+    IF NEW.platform = 'openai' AND NEW.type = 'oauth' OR
+       TG_OP = 'UPDATE' AND OLD.platform = 'openai' AND OLD.type = 'oauth' THEN
+        NEW.credentials := jsonb_set(NEW.credentials, '{_oauth_revision}', to_jsonb(NEW.oauth_revision::text));
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER fence_openai_oauth_account BEFORE INSERT OR UPDATE ON accounts
+    FOR EACH ROW EXECUTE FUNCTION fence_openai_oauth_account();
+
+-- Includes raw/bulk lifecycle writes. Invalidation is committed with the row.
+CREATE FUNCTION publish_openai_oauth_account() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP = 'DELETE' THEN
+        IF OLD.platform = 'openai' AND OLD.type = 'oauth' OR OLD.credentials ? '_oauth_revision' THEN
+            INSERT INTO account_oauth_tombstones VALUES (OLD.id, OLD.oauth_revision + 1)
+                ON CONFLICT (account_id) DO UPDATE SET revision=GREATEST(account_oauth_tombstones.revision, EXCLUDED.revision);
+            INSERT INTO scheduler_outbox(event_type, account_id) VALUES ('account_changed', OLD.id);
+        END IF;
+        RETURN OLD;
+    END IF;
+    IF (NEW.platform = 'openai' AND NEW.type = 'oauth') OR
+       (OLD.platform = 'openai' AND OLD.type = 'oauth') THEN
+        IF NEW.oauth_revision IS DISTINCT FROM OLD.oauth_revision THEN
+            INSERT INTO scheduler_outbox(event_type, account_id) VALUES ('account_changed', NEW.id);
+        END IF;
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER publish_openai_oauth_account AFTER UPDATE OR DELETE ON accounts
+    FOR EACH ROW EXECUTE FUNCTION publish_openai_oauth_account();
+
+-- Group binding is routing identity too. Use the same account row domain.
+CREATE FUNCTION fence_openai_oauth_group_binding() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP <> 'INSERT' THEN
+        UPDATE accounts SET credentials = jsonb_set(credentials, '{_oauth_group_change}', to_jsonb(gen_random_uuid()::text))
+            WHERE id = OLD.account_id AND platform = 'openai' AND type = 'oauth';
+    END IF;
+    IF TG_OP <> 'DELETE' THEN
+        UPDATE accounts SET credentials = jsonb_set(credentials, '{_oauth_group_change}', to_jsonb(gen_random_uuid()::text))
+            WHERE id = NEW.account_id AND platform = 'openai' AND type = 'oauth';
+    END IF;
+    RETURN NULL;
+END $$;
+CREATE TRIGGER fence_openai_oauth_group_binding AFTER INSERT OR UPDATE OR DELETE ON account_groups
+    FOR EACH ROW EXECUTE FUNCTION fence_openai_oauth_group_binding();
+
+-- Editing a proxy changes the routing identity of every referencing OAuth row.
+CREATE FUNCTION fence_openai_oauth_proxy() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.protocol, NEW.host, NEW.port, NEW.username, NEW.password, NEW.status, NEW.deleted_at)
+       IS DISTINCT FROM ROW(OLD.protocol, OLD.host, OLD.port, OLD.username, OLD.password, OLD.status, OLD.deleted_at) THEN
+        UPDATE accounts SET credentials=jsonb_set(credentials, '{_oauth_proxy_change}', to_jsonb(gen_random_uuid()::text))
+            WHERE proxy_id=NEW.id AND platform='openai' AND type='oauth';
+    END IF;
+    RETURN NEW;
+END $$;
+CREATE TRIGGER fence_openai_oauth_proxy AFTER UPDATE ON proxies
+    FOR EACH ROW EXECUTE FUNCTION fence_openai_oauth_proxy();
