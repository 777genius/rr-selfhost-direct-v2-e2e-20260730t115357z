+// CASE protects the strict identity function in every multi-account query.
+// PostgreSQL may reorder AND/OR operands; malformed rows must never reach it.
+// Credential shadows have no own refresh token; their parent is admitted separately.
+func oauthNoPendingPredicate() dbpredicate.Account {
+	return func(s *entsql.Selector) {
+		credentials := s.C("credentials")
+		s.Where(entsql.ExprP("CASE WHEN " + s.C("platform") + " <> 'openai' OR " + s.C("type") + " <> 'oauth' THEN TRUE " +
+			"WHEN jsonb_typeof(" + credentials + ")='object' " +
+			"AND COALESCE(jsonb_typeof(" + credentials + "->'client_id'),'null') IN ('string','null') " +
+			"AND COALESCE(jsonb_typeof(" + credentials + "->'refresh_token'),'null') IN ('string','null') " +
+			"AND (" + s.C("parent_account_id") + " IS NOT NULL OR COALESCE(" + credentials + "->>'refresh_token','')<>'') " +
+			"THEN NOT EXISTS (SELECT 1 FROM openai_oauth_consumption p WHERE p.identity=openai_oauth_refresh_identity(" + credentials + ") AND p.state<>'reusable') ELSE FALSE END"))
+	}
+}
