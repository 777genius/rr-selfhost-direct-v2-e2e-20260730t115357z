+func (s *SchedulerSnapshotService) validateOAuthCandidates(ctx context.Context, accounts []Account, bucket SchedulerBucket) []Account {
+	out := make([]Account, 0, len(accounts))
+	for _, account := range accounts {
+		if account.Platform != PlatformOpenAI || account.Type != AccountTypeOAuth {
+			out = append(out, account)
+			continue
+		}
+		durable, ok := s.accountRepo.(OpenAIOAuthDurableRepository)
+		if !ok {
+			continue
+		}
+		current, pending, err := durable.LoadOAuthState(ctx, account.ID)
+		if err != nil || pending || !current.IsSchedulable() {
+			continue
+		}
+		if bucket.GroupID > 0 {
+			member := false
+			for _, id := range current.GroupIDs {
+				if id == bucket.GroupID {
+					member = true
+					break
+				}
+			}
+			if !member {
+				continue
+			}
+		}
+		out = append(out, *current)
+	}
+	return out
+}
