+		if a.OAuthEditBase != nil {
+			return errOAuthProtected
+		}
+		return nil
+	}
+	base := a.OAuthEditBase
+	if base == nil {
+		return errOAuthProtected
+	}
+	// Explicit credential keys alone may replace tokens. Omitted/unchanged
+	// sensitive keys preserve concurrently rotated credentials.
+	merged := copyJSONMap(current.Credentials)
+	for key, value := range a.Credentials {
+		if key == "_oauth_revision" || key == "_oauth_group_change" {
+			continue
+		}
+		if old, exists := base.Credentials[key]; !exists || !reflect.DeepEqual(old, value) || a.OAuthCredentialFields[key] {
+			merged[key] = value
+		}
+	}
+	for key := range base.Credentials {
+		if _, exists := a.Credentials[key]; !exists && key != "_oauth_revision" && key != "_oauth_group_change" {
+			delete(merged, key)
+		}
+	}
+	a.Credentials = merged
+	mergedExtra := copyJSONMap(current.Extra)
+	if mergedExtra == nil {
+		mergedExtra = make(map[string]any)
+	}
+	for key, value := range a.Extra {
+		if old, exists := base.Extra[key]; !exists || !reflect.DeepEqual(old, value) {
+			mergedExtra[key] = value
+		}
+	}
+	for key := range base.Extra {
+		if _, exists := a.Extra[key]; !exists {
+			delete(mergedExtra, key)
+		}
+	}
+	a.Extra = mergedExtra
