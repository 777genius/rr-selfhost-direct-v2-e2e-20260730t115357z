+-- One stable, private DB-custodied HMAC key. No API configuration or token index.
+CREATE TABLE openai_oauth_identity_key (
+    singleton boolean PRIMARY KEY DEFAULT true CHECK (singleton),
+    secret bytea NOT NULL CHECK (octet_length(secret)=32)
+);
+INSERT INTO openai_oauth_identity_key(secret)
+VALUES (sha256(convert_to(gen_random_uuid()::text || gen_random_uuid()::text, 'UTF8')));
+CREATE FUNCTION protect_openai_oauth_identity_key() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN RAISE EXCEPTION 'OAuth identity key is immutable; preserve it during custody rotation'; END $$;
+CREATE TRIGGER protect_openai_oauth_identity_key BEFORE UPDATE OR DELETE ON openai_oauth_identity_key
+    FOR EACH ROW EXECUTE FUNCTION protect_openai_oauth_identity_key();
+
+-- RFC2104 HMAC-SHA256 using PostgreSQL built-in bytea SHA256 (no extension).
+-- Framed JSON array, fixed issuer and the effective official client fallback.
+CREATE FUNCTION openai_oauth_refresh_identity(credentials jsonb) RETURNS text
+LANGUAGE plpgsql STABLE STRICT AS $$
+DECLARE
+    secret bytea; ipad bytea := decode(repeat('36',64),'hex');
+    opad bytea := decode(repeat('5c',64),'hex'); message bytea; idx integer;
+BEGIN
+    IF COALESCE(credentials->>'refresh_token','')='' THEN RETURN NULL; END IF;
+    SELECT k.secret INTO STRICT secret FROM openai_oauth_identity_key k WHERE k.singleton;
+    FOR idx IN 0..31 LOOP
+        ipad := set_byte(ipad,idx,get_byte(ipad,idx) # get_byte(secret,idx));
+        opad := set_byte(opad,idx,get_byte(opad,idx) # get_byte(secret,idx));
+    END LOOP;
+    message := convert_to(jsonb_build_array('openai-refresh-v1','https://auth.openai.com/oauth/token',
+        COALESCE(NULLIF(btrim(credentials->>'client_id'),''),'app_EMoamEEZ73f0CkXaXp7hrann'),
+        credentials->>'refresh_token')::text,'UTF8');
+    RETURN encode(sha256(opad || sha256(ipad || message)),'hex');
+END $$;
+
+CREATE TABLE openai_oauth_consumption (
+    identity text PRIMARY KEY CHECK (length(identity)=64),
+    state text NOT NULL CHECK (state IN ('pending','consumed','reusable')),
+    owner text NOT NULL,
+    account_id bigint NOT NULL,
+    revision bigint NOT NULL
+); -- No account FK: deletion/reimport must preserve non-replay evidence.
+ALTER TABLE account_oauth_refresh_attempts ADD COLUMN input_identity text;
+ALTER TABLE account_oauth_refresh_attempts ADD COLUMN result_identity text;
+UPDATE account_oauth_refresh_attempts SET
+    input_identity=openai_oauth_refresh_identity(expected_credentials),
+    result_identity=openai_oauth_refresh_identity(result_credentials);
+-- Historical ambiguity is quarantined. Only an unambiguous successfully
+-- completed same-identity attempt is reusable; uncertainty never expires.
+INSERT INTO openai_oauth_consumption(identity,state,owner,account_id,revision)
+SELECT input_identity,
+    CASE WHEN count(*)=1 AND bool_and(state='completed' AND result_identity=input_identity)
+         THEN 'reusable' ELSE 'consumed' END,
+    min(owner),min(account_id),min(revision)
+FROM account_oauth_refresh_attempts WHERE input_identity IS NOT NULL GROUP BY input_identity;
+CREATE INDEX account_oauth_refresh_identity ON account_oauth_refresh_attempts(input_identity);
+
+-- Only observed usage snapshots are neutral. Routing/configuration Extra
+-- keys (including probe switches, fingerprints, model settings) stay fenced.
+CREATE FUNCTION openai_oauth_fenced_extra(extra jsonb) RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
+    SELECT COALESCE(jsonb_object_agg(key,value),'{}'::jsonb)
+    FROM jsonb_each(COALESCE(extra,'{}'::jsonb))
+    WHERE key NOT IN ('codex_usage_updated_at','codex_credits_snapshot','codex_referral_snapshot',
+                     'grok_billing_snapshot','session_window_utilization')
+      AND key !~ '^(codex_primary_|codex_secondary_|codex_5h_|codex_7d_|codex_reset_credit_|passive_usage_)'
+$$;
+CREATE OR REPLACE FUNCTION fence_openai_oauth_account() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF TG_OP='INSERT' THEN NEW.oauth_revision:=1;
+    ELSE
+        NEW.oauth_revision:=OLD.oauth_revision;
+        IF (OLD.platform='openai' AND OLD.type='oauth') OR (NEW.platform='openai' AND NEW.type='oauth') THEN
+            IF (to_jsonb(NEW)-ARRAY['oauth_revision','credentials','extra','updated_at','last_used_at','created_at'])
+                IS DISTINCT FROM (to_jsonb(OLD)-ARRAY['oauth_revision','credentials','extra','updated_at','last_used_at','created_at'])
+                OR (NEW.credentials-'_oauth_revision') IS DISTINCT FROM (OLD.credentials-'_oauth_revision')
+                OR openai_oauth_fenced_extra(NEW.extra) IS DISTINCT FROM openai_oauth_fenced_extra(OLD.extra) THEN
+                NEW.oauth_revision:=OLD.oauth_revision+1;
+            END IF;
+        END IF;
+    END IF;
+    IF NEW.platform='openai' AND NEW.type='oauth' OR TG_OP='UPDATE' AND OLD.platform='openai' AND OLD.type='oauth' THEN
+        NEW.credentials:=jsonb_set(NEW.credentials,'{_oauth_revision}',to_jsonb(NEW.oauth_revision::text));
+    END IF;
+    RETURN NEW;
+END $$;
+
+-- Keep exact current completion for lost-ACK reconciliation. Once superseded
+-- (or deleted), completed/terminal full documents are obsolete. Pending is
+-- deliberately retained, including reconciliation material; there is no TTL.
+CREATE FUNCTION redact_openai_oauth_history() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE history_account_id bigint; current_revision bigint;
+BEGIN
+    IF TG_OP='DELETE' THEN history_account_id:=OLD.id; current_revision:=NULL;
+    ELSE history_account_id:=NEW.id; current_revision:=NEW.oauth_revision; END IF;
+    UPDATE account_oauth_refresh_attempts p SET expected_credentials='{}'::jsonb,result_credentials=NULL
+    WHERE p.account_id=history_account_id AND p.state IN ('completed','terminal')
+      AND (current_revision IS NULL OR p.completion_revision IS DISTINCT FROM current_revision);
+    RETURN NULL;
+END $$;
+CREATE TRIGGER redact_openai_oauth_history AFTER UPDATE OR DELETE ON accounts
+    FOR EACH ROW EXECUTE FUNCTION redact_openai_oauth_history();
+UPDATE account_oauth_refresh_attempts p SET expected_credentials='{}'::jsonb,
+    result_credentials=CASE WHEN EXISTS (SELECT 1 FROM accounts a WHERE a.id=p.account_id
+        AND a.deleted_at IS NULL AND a.oauth_revision=p.completion_revision)
+        THEN p.result_credentials ELSE NULL END
+WHERE p.state IN ('completed','terminal');
--- /dev/null
