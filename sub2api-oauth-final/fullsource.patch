+// BindOAuthRequest exposes tuple binding before handler prefetch and hooks.
+// Other platforms retain their request credential and failover path.
+func (s *OpenAIGatewayService) BindOAuthRequest(ctx context.Context, selected *Account) (context.Context, *Account, error) {
+	return s.bindOAuthForward(ctx, selected, "")
+}
+
+// Bind before request transforms/transport choice. A selected stale row is
+// denied; rotating a still-current selection returns one fresh execution
+// snapshot. Shadow quota/model/scheduling fields remain on a distinct copy.
+func (s *OpenAIGatewayService) bindOAuthForward(ctx context.Context, selected *Account, suppliedToken string) (context.Context, *Account, error) {
+	if selected == nil {
+		return ctx, nil, oauthProtected()
+	}
+	if selected.Platform != PlatformOpenAI || selected.Type != AccountTypeOAuth {
+		return ctx, selected, nil
+	}
+	durable, ok := s.accountRepo.(OpenAIOAuthDurableRepository)
+	if !ok {
+		return ctx, nil, oauthProtected()
+	}
+	if bound, ok := ctx.Value(oauthForwardBindingKey{}).(*oauthForwardBinding); ok && bound.selectionID == selected.ID {
+		// Reconnect/disable between prefetch and ingress still deny. Only
+		// this private execution snapshot may use the completed own tuple.
+		if selected != bound.execution || suppliedToken != "" && suppliedToken != bound.token {
+			return ctx, nil, oauthProtected()
+		}
+		current, pending, err := durable.LoadOAuthState(ctx, bound.credential.ID)
+		if err != nil || pending || !openAIAccountAdmitted(ctx, current) ||
+			OAuthRevision(current) != OAuthRevision(bound.credential) || !reflect.DeepEqual(current.Credentials, bound.credential.Credentials) {
+			return ctx, nil, oauthProtected()
+		}
+		if selected.IsShadow() {
+			child, blocked, err := durable.LoadOAuthState(ctx, selected.ID)
+			if err != nil || blocked || !child.IsSchedulable() || OAuthRevision(child) != bound.selectionRevision {
+				return ctx, nil, oauthProtected()
+			}
+		}
+		return ctx, bound.execution, nil
+	}
+	current, pending, err := durable.LoadOAuthState(ctx, selected.ID)
+	if err != nil || pending || !current.IsSchedulable() || OAuthRevision(selected) == "" ||
+		OAuthRevision(selected) != OAuthRevision(current) || !reflect.DeepEqual(selected.Credentials, current.Credentials) {
+		return ctx, nil, oauthProtected()
+	}
+	credential := current
+	if current.IsShadow() {
+		credential, pending, err = durable.LoadOAuthState(ctx, *current.ParentAccountID)
+		ctx = withOAuthCredentialParent(ctx, *current.ParentAccountID)
+		if err != nil || pending || !openAIAccountAdmitted(ctx, credential) {
+			return ctx, nil, oauthProtected()
+		}
+	}
+	token, mode := suppliedToken, "oauth"
+	if suppliedToken == "" {
+		token, mode, err = s.GetAccessToken(ctx, current)
+		if err != nil {
+			return ctx, nil, err
+		}
+	}
+	// Provider cache/issuer I/O may overlap reconnect, disable or rotation.
+	// Admit its exact bearer together with the matching full identity/route.
+	credential, pending, err = durable.LoadOAuthState(ctx, credential.ID)
+	if err != nil || pending || !openAIAccountAdmitted(ctx, credential) ||
+		(mode == "oauth" && (token == "" || token != credential.GetOpenAIAccessToken())) {
+		return ctx, nil, oauthProtected()
+	}
+	credential, err = cloneOAuthExecutionAccount(credential)
+	if err != nil {
+		return ctx, nil, err
+	}
+	execution := credential
+	if current.IsShadow() {
+		// Recheck the scheduling child after token I/O as well. Never replace
+		// its ID, quota dimension, model mappings or groups with the parent's.
+		shadow, blocked, e := durable.LoadOAuthState(ctx, current.ID)
+		if e != nil || blocked || !shadow.IsSchedulable() || OAuthRevision(shadow) != OAuthRevision(current) {
+			return ctx, nil, oauthProtected()
+		}
+		execution, e = cloneOAuthExecutionAccount(shadow)
+		if e != nil {
+			return ctx, nil, e
+		}
+		// Project authentication from the admitted parent into this private
+		// execution copy; retain child model/scheduling overrides separately.
+		childCredentials := execution.Credentials
+		execution.Credentials = make(map[string]any, len(credential.Credentials))
+		for key, value := range credential.Credentials {
+			execution.Credentials[key] = value
+		}
+		for _, key := range []string{"model_mapping", "compact_model_mapping", "account_scheduling_threshold"} {
+			if value, ok := childCredentials[key]; ok {
+				execution.Credentials[key] = value
+			}
+		}
+		execution.ProxyID = credential.ProxyID
+		execution.Proxy = credential.Proxy
+	}
+	execution.oauthForwardRevision = OAuthRevision(credential)
+	bound := &oauthForwardBinding{selectionID: execution.ID, selectionRevision: OAuthRevision(current), credential: credential, execution: execution, token: token, mode: mode}
+	return context.WithValue(ctx, oauthForwardBindingKey{}, bound), execution, nil
+}
