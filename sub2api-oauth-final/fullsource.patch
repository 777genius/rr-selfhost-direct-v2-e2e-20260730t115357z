+// OpenAI leases return an acquisition handle; never key ownership by account
+// in a process-local map. A predecessor cannot delete a successor's lease.
+func (c *geminiTokenCache) AcquireOAuthRefreshLease(ctx context.Context, key string, ttl time.Duration) (string, error) {
+	var random [24]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return "", err
+	}
+	owner := hex.EncodeToString(random[:])
+	acquired, err := c.rdb.SetNX(ctx, oauthRefreshLockKeyPrefix+key, owner, ttl).Result()
+	if err != nil || !acquired {
+		return "", err
+	}
+	return owner, nil
