+		if !a.OAuthEditFields[field] && reflect.DeepEqual(av.FieldByName(field).Interface(), bv.FieldByName(field).Interface()) {
+			av.FieldByName(field).Set(cv.FieldByName(field))
+		}
+	}
+	return nil
+}
