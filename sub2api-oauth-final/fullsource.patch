+// Read the Ent account then validate that entire snapshot against one SQL
+// statement. A concurrent mutation yields a protected rejection, never stale
+// eligibility. Pending is independent of Redis and survives process restarts.
+func (r *accountRepository) LoadOAuthState(ctx context.Context, id int64) (*service.Account, bool, error) {
+	// Retry only snapshot reads when a concurrent committed rotation changes
+	// the row between Ent hydration and SQL validation. Never retry issuer work.
+	for read := 0; read < 3; read++ {
+		a, err := r.GetByID(ctx, id)
+		if err != nil {
+			return nil, false, errOAuthProtected
+		}
+		payload, err := json.Marshal(a.Credentials)
+		if err != nil {
+			return nil, false, errOAuthProtected
+		}
+		rows, err := r.sql.QueryContext(ctx, `SELECT EXISTS (SELECT 1 FROM openai_oauth_consumption p
+            WHERE p.identity=openai_oauth_refresh_identity(a.credentials) AND p.state<>'reusable') FROM accounts a WHERE a.id=$1 AND a.deleted_at IS NULL
+		AND a.platform='openai' AND a.type='oauth' AND a.status='active'
+		AND (NOT a.auto_pause_on_expired OR a.expires_at IS NULL OR a.expires_at>now())
+		AND a.oauth_revision::text=$2 AND a.credentials=$3::jsonb`, id, service.OAuthRevision(a), string(payload))
+		if err != nil {
+			return nil, false, errOAuthProtected
+		}
+		if !rows.Next() {
+			err = rows.Err()
+			rows.Close()
+			if err != nil {
+				return nil, false, errOAuthProtected
+			}
+			continue
+		}
+		var pending bool
+		err = rows.Scan(&pending)
+		rows.Close()
+		if err != nil {
+			return nil, false, errOAuthProtected
+		}
+		return a, pending, nil
+	}
+	return nil, false, errOAuthProtected
+}
+
+func (r *accountRepository) ClaimOAuthRefresh(ctx context.Context, a *service.Account, owner string) (bool, error) {
+	expected, err := json.Marshal(a.Credentials)
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	tx, err := r.client.Tx(ctx)
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	defer tx.Rollback()
+	client := tx.Client()
+	// The row lock lasts only until claim commit, never across issuer HTTP.
+	rows, err := client.QueryContext(ctx, `SELECT id FROM accounts WHERE id=$1
+	AND oauth_revision::text=$2 AND credentials=$3::jsonb
+	AND platform='openai' AND type='oauth' AND status='active'
+	AND deleted_at IS NULL AND (NOT auto_pause_on_expired OR expires_at IS NULL OR expires_at>now())
+	AND proxy_id IS NOT DISTINCT FROM $4 FOR UPDATE`,
+		a.ID, service.OAuthRevision(a), string(expected), a.ProxyID)
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	matched := rows.Next()
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	if !matched {
+		return false, nil
+	}
+	// The unique keyed identity serializes different account IDs. A reusable
+	// domain is reopened only after exact durable nonrotating completion.
+	result, err := client.ExecContext(ctx, `INSERT INTO openai_oauth_consumption
+    (identity,state,owner,account_id,revision)
+    VALUES (openai_oauth_refresh_identity($4::jsonb),'pending',$3,$1,$2::bigint)
+    ON CONFLICT (identity) DO UPDATE SET state='pending',owner=EXCLUDED.owner,
+    account_id=EXCLUDED.account_id,revision=EXCLUDED.revision
+    WHERE openai_oauth_consumption.state='reusable'`, a.ID, service.OAuthRevision(a), owner, string(expected))
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	if n == 0 {
+		return false, nil
+	}
+	_, err = client.ExecContext(ctx, `INSERT INTO account_oauth_refresh_attempts
+    (account_id,revision,owner,state,expected_credentials,input_identity)
+    VALUES ($1,$2::bigint,$3,'pending',$4::jsonb,openai_oauth_refresh_identity($4::jsonb))`,
+		a.ID, service.OAuthRevision(a), owner, string(expected))
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	if err := tx.Commit(); err == nil {
+		return true, nil
+	}
+	_ = tx.Rollback()
+	// A lost claim acknowledgement is safe only if this exact owner is durable.
+	rows, err = r.sql.QueryContext(ctx, `SELECT owner FROM account_oauth_refresh_attempts
+	WHERE account_id=$1 AND revision=$2::bigint AND owner=$3 AND state='pending'`, a.ID, service.OAuthRevision(a), owner)
+	if err != nil {
+		return false, errOAuthProtected
+	}
+	defer rows.Close()
+	var durableOwner string
+	if rows.Next() && rows.Scan(&durableOwner) == nil && durableOwner == owner {
+		return true, nil
+	}
+	return false, errOAuthProtected
+}
+
+func (r *accountRepository) CompleteOAuthRefresh(ctx context.Context, a *service.Account, owner string, credentials map[string]any, terminal bool) (*service.Account, bool, error) {
+	expected, err := json.Marshal(a.Credentials)
+	if err != nil {
+		return nil, false, errOAuthProtected
+	}
+	if !terminal {
+		version, err := strconv.ParseInt(service.OAuthRevision(a), 10, 64)
+		if err != nil || version <= 0 || version == 1<<63-1 {
+			return nil, false, errOAuthProtected
+		}
+		credentials["_token_version"] = strconv.FormatInt(version+1, 10)
+	} else {
+		credentials = a.Credentials
+	}
+	payload, err := json.Marshal(credentials)
+	if err != nil {
+		return nil, false, errOAuthProtected
+	}
+	tx, err := r.client.Tx(ctx)
+	if err == nil {
+		client := tx.Client()
+		// Owner, complete credential document, revision, routing and lifecycle
+		// all fence completion. The revision trigger covers lower/raw mutations.
+		rows, updateErr := client.QueryContext(ctx, `UPDATE accounts a SET
+		credentials=CASE WHEN $6 THEN a.credentials ELSE $5::jsonb END,
+		status=CASE WHEN $6 THEN 'error' ELSE a.status END,
+		schedulable=CASE WHEN $6 THEN false ELSE a.schedulable END,
+		error_message=CASE WHEN $6 THEN 'OpenAI OAuth invalid_grant' ELSE a.error_message END,
+		updated_at=now()
+		WHERE a.id=$1 AND a.oauth_revision::text=$2 AND a.credentials=$3::jsonb
+		AND a.proxy_id IS NOT DISTINCT FROM $4 AND a.deleted_at IS NULL
+		AND a.platform='openai' AND a.type='oauth' AND a.status='active'
+		AND EXISTS (SELECT 1 FROM account_oauth_refresh_attempts p WHERE p.account_id=a.id
+		AND p.revision=a.oauth_revision AND p.owner=$7 AND p.state='pending')
+		RETURNING a.oauth_revision,a.credentials`, a.ID, service.OAuthRevision(a), string(expected), a.ProxyID, string(payload), terminal, owner)
+		var revision int64
+		var resultJSON []byte
+		matched := false
+		if updateErr == nil {
+			matched = rows.Next()
+			if matched {
+				updateErr = rows.Scan(&revision, &resultJSON)
+			}
+			if updateErr == nil {
+				updateErr = rows.Err()
+			}
+			rows.Close()
+		}
+		if updateErr == nil && matched {
+			state := "completed"
+			if terminal {
+				state = "terminal"
+			}
+			_, updateErr = client.ExecContext(ctx, `UPDATE account_oauth_refresh_attempts SET
+			state=$1,expected_credentials='{}'::jsonb,result_credentials=$2::jsonb,completion_revision=$3,result_identity=openai_oauth_refresh_identity($2::jsonb)
+			WHERE account_id=$4 AND revision=$5::bigint AND owner=$6 AND state='pending'`,
+				state, string(resultJSON), revision, a.ID, service.OAuthRevision(a), owner)
+		}
+		if updateErr == nil && !matched && !terminal {
+			// A returned successor fenced by reconnect/routing is still useful
+			// for explicit reconciliation. It grants no admission or retry.
+			_, updateErr = client.ExecContext(ctx, `UPDATE account_oauth_refresh_attempts SET
+            result_credentials=$1::jsonb,result_identity=openai_oauth_refresh_identity($1::jsonb)
+            WHERE account_id=$2 AND revision=$3::bigint AND owner=$4 AND state='pending'`,
+				string(payload), a.ID, service.OAuthRevision(a), owner)
+		}
+		if updateErr == nil && matched {
+			// Only a successful persisted same identity is safe to consume
+			// again. Terminal/rotated identities are permanently consumed.
+			_, updateErr = client.ExecContext(ctx, `UPDATE openai_oauth_consumption d SET
+            state=CASE WHEN NOT $2 AND d.identity=openai_oauth_refresh_identity($3::jsonb)
+                       THEN 'reusable' ELSE 'consumed' END
+            WHERE d.owner=$1 AND d.state='pending'`, owner, terminal, string(resultJSON))
+		}
+		if updateErr == nil {
+			updateErr = tx.Commit()
+		}
+		_ = tx.Rollback() // Release any failed transaction before independent reread.
+		// Do not retry the issuer or treat an acknowledgement as a durable result.
+	}
+	current, readErr := r.GetByID(ctx, a.ID)
+	if readErr != nil || current == nil {
+		return nil, false, errOAuthProtected
+	}
+	rows, readErr := r.sql.QueryContext(ctx, `SELECT p.state FROM account_oauth_refresh_attempts p
+	JOIN accounts a ON a.id=p.account_id WHERE p.account_id=$1 AND p.revision=$2::bigint AND p.owner=$3
+	AND p.completion_revision=a.oauth_revision AND p.result_credentials=a.credentials
+	AND (p.state='terminal' AND $4 OR p.state='completed' AND NOT $4
+	AND (p.result_credentials-'_oauth_revision')=($5::jsonb-'_oauth_revision'))
+	AND a.credentials=$6::jsonb`, a.ID, service.OAuthRevision(a), owner, terminal, string(payload), mustJSON(current.Credentials))
+	if readErr != nil {
+		return nil, false, errOAuthProtected
+	}
+	exact := rows.Next()
+	readErr = rows.Err()
+	rows.Close()
+	if readErr != nil {
+		return nil, false, errOAuthProtected
+	}
+	if exact {
+		r.syncSchedulerAccountSnapshotDetached(ctx, a.ID)
+		return current, true, nil
+	}
+	// Reconnect/disable wins a completion CAS. Unchanged attempted state is
+	// persistence uncertainty, retaining the original durable pending claim.
+	if service.OAuthRevision(current) != service.OAuthRevision(a) {
+		return current, false, nil
+	}
+	return nil, false, errOAuthProtected
+}
+
+func mustJSON(v map[string]any) string { b, _ := json.Marshal(v); return string(b) }
+
+func (r *accountRepository) BlockOAuthMissingRefresh(ctx context.Context, a *service.Account) error {
+	_, err := r.sql.ExecContext(ctx, `UPDATE accounts SET status='error',schedulable=false,
+	error_message='OpenAI OAuth refresh token missing',updated_at=now()
