+-- Never infer canonical aliases from opaque historical HMACs. Refuse this
+-- not-yet-deployed fork upgrade if ANY refresh history exists. An operator
+-- must reconcile from protected retained material, preserving all uncertainty
+-- and proving alias coverage. No deletion, reset or bypass is permitted.
+LOCK TABLE accounts, account_oauth_refresh_attempts, openai_oauth_consumption IN ACCESS EXCLUSIVE MODE;
+DO $$ BEGIN
+    IF EXISTS (SELECT 1 FROM openai_oauth_consumption)
+       OR EXISTS (SELECT 1 FROM account_oauth_refresh_attempts) THEN
+        RAISE EXCEPTION 'OpenAI OAuth identity upgrade requires protected history reconciliation; no automatic alias mapping' USING ERRCODE='55000';
+    END IF;
+END $$;
+
+-- Exact Go unicode.IsSpace set. Refresh bytes remain unchanged on the wire.
+CREATE OR REPLACE FUNCTION openai_oauth_refresh_identity(credentials jsonb) RETURNS text
+LANGUAGE plpgsql STABLE STRICT AS $$
+DECLARE
+    secret bytea; ipad bytea := decode(repeat('36',64),'hex');
+    opad bytea := decode(repeat('5c',64),'hex'); message bytea; idx integer;
+BEGIN
+    IF jsonb_typeof(credentials) <> 'object'
+       OR COALESCE(jsonb_typeof(credentials->'client_id'),'null') NOT IN ('string','null')
+       OR COALESCE(jsonb_typeof(credentials->'refresh_token'),'null') NOT IN ('string','null') THEN
+        RAISE EXCEPTION 'Unsupported OpenAI OAuth identity credential type' USING ERRCODE='22023';
+    END IF;
+    IF COALESCE(credentials->>'refresh_token','')='' THEN RETURN NULL; END IF;
+    SELECT k.secret INTO STRICT secret FROM openai_oauth_identity_key k WHERE k.singleton;
+    FOR idx IN 0..31 LOOP
+        ipad := set_byte(ipad,idx,get_byte(ipad,idx) # get_byte(secret,idx));
+        opad := set_byte(opad,idx,get_byte(opad,idx) # get_byte(secret,idx));
+    END LOOP;
+    message := convert_to(jsonb_build_array('openai-refresh-v1','https://auth.openai.com/oauth/token',
+        COALESCE(NULLIF(btrim(credentials->>'client_id', U&'\0009\000A\000B\000C\000D\0020\0085\00A0\1680\2000\2001\2002\2003\2004\2005\2006\2007\2008\2009\200A\2028\2029\202F\205F\3000'),''),'app_EMoamEEZ73f0CkXaXp7hrann'),
+        credentials->>'refresh_token')::text,'UTF8');
+    RETURN encode(sha256(opad || sha256(ipad || message)),'hex');
+END $$;
+
+
+CREATE OR REPLACE FUNCTION fence_openai_oauth_proxy() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+    IF ROW(NEW.protocol, NEW.host, NEW.port, NEW.username, NEW.password, NEW.status, NEW.deleted_at, NEW.expires_at)
+       IS DISTINCT FROM ROW(OLD.protocol, OLD.host, OLD.port, OLD.username, OLD.password, OLD.status, OLD.deleted_at, OLD.expires_at) THEN
+        UPDATE accounts SET credentials=jsonb_set(credentials, '{_oauth_proxy_change}', to_jsonb(gen_random_uuid()::text))
+            WHERE proxy_id=NEW.id AND platform='openai' AND type='oauth';
+    END IF;
+    RETURN NEW;
+END $$;
