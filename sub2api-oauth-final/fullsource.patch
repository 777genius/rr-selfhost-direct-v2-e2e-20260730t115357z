+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"strings"
+	"time"
+
+	infraerrors "github.com/Wei-Shaw/sub2api/internal/pkg/errors"
+)
+
+// This capability is mandatory for every account-scoped OpenAI refresh path.
+// Claims and completion are short transactions; provider HTTP is outside them.
+type OpenAIOAuthDurableRepository interface {
+	LoadOAuthState(context.Context, int64) (*Account, bool, error)
+	ClaimOAuthRefresh(context.Context, *Account, string) (bool, error)
+	CompleteOAuthRefresh(context.Context, *Account, string, map[string]any, bool) (*Account, bool, error)
+	BlockOAuthMissingRefresh(context.Context, *Account) error
+}
+
+type OAuthOwnedLeaseCache interface {
+	AcquireOAuthRefreshLease(context.Context, string, time.Duration) (string, error)
+	ReleaseOAuthRefreshLease(context.Context, string, string) error
+}
+
+type OAuthRevisionTokenCache interface {
+	GetOAuthAccessToken(context.Context, string, string) (string, error)
+	SetOAuthAccessToken(context.Context, string, string, string, time.Duration) error
+	DeleteOAuthAccessToken(context.Context, string, string) error
+}
+
+type OAuthRevisionSchedulerCache interface {
+	DeleteOAuthAccount(context.Context, int64, string) error
+}
+
+type oauthClaimContextKey struct{}
+type oauthClaimContext struct {
+	id    int64
+	owner string
+}
+
+func oauthProtected() error {
+	return &providerCycleContainmentRefreshError{err: errors.New("OpenAI OAuth state is protected; reconnect or reconcile the durable attempt")}
+}
+
+func OAuthRevision(a *Account) string {
+	if a == nil {
+		return ""
+	}
+	return a.GetCredential("_oauth_revision")
+}
+
+// ValidateOpenAIOAuthIdentityCredentials checks only the two wire identity fields.
+// Unknown business fields and credentials for other platforms/types remain valid.
+// It never normalizes client strings or refresh-token bytes.
+func ValidateOpenAIOAuthIdentityCredentials(a *Account) error {
+	if a == nil || a.Platform != PlatformOpenAI || a.Type != AccountTypeOAuth {
+		return nil
+	}
+	for _, key := range []string{"client_id", "refresh_token"} {
+		if value := a.Credentials[key]; value != nil {
+			if _, ok := value.(string); !ok {
+				return infraerrors.BadRequest("INVALID_OPENAI_OAUTH_IDENTITY", "OpenAI OAuth "+key+" must be a string or null")
+			}
+		}
+	}
+	return nil
+}
+
+func openAIOAuthEligible(a *Account) bool {
+	return a != nil && a.Platform == PlatformOpenAI && a.Type == AccountTypeOAuth &&
+		ValidateOpenAIOAuthIdentityCredentials(a) == nil && a.IsActive() &&
+		(!a.AutoPauseOnExpired || a.ExpiresAt == nil || time.Now().Before(*a.ExpiresAt))
+}
+
+// Parent intent is scoped to one durable ID and introduced only by a validated
+// shadow path. It never changes the parent's direct scheduling configuration.
+type oauthCredentialParentKey struct{}
+
+func withOAuthCredentialParent(ctx context.Context, id int64) context.Context {
+	return context.WithValue(ctx, oauthCredentialParentKey{}, id)
+}
+func openAIAccountAdmitted(ctx context.Context, a *Account) bool {
+	if !openAIOAuthEligible(a) {
+		return false
+	}
+	if a.ProxyID != nil && (a.Proxy == nil || !a.Proxy.IsActive() || a.Proxy.IsExpired(time.Now())) {
+		return false
+	}
+
+	if id, ok := ctx.Value(oauthCredentialParentKey{}).(int64); ok && id == a.ID {
+		return a.IsCredentialUsableForShadow() && !a.IsShadow()
+	}
+	return a.IsSchedulable()
+}
+
+// Read and wait on durable state, including token-cache hits. Redis errors never
+// alter admission. A crashed owner remains pending indefinitely; waiting is bounded.
+func loadOpenAIUsableAccount(ctx context.Context, repo AccountRepository, id int64) (*Account, error) {
+	durable, ok := repo.(OpenAIOAuthDurableRepository)
+	if !ok {
+		return nil, oauthProtected()
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	observedPending := false
+	for {
+		a, pending, err := durable.LoadOAuthState(waitCtx, id)
+		if err != nil || !openAIAccountAdmitted(ctx, a) {
+			return nil, oauthProtected()
+		}
+		if !pending {
+			return a, nil
+		}
+		if !observedPending {
+			slog.Info("oauth_refresh.pg_claim_contended", "account_id", id)
+			observedPending = true
+		}
+		timer := time.NewTimer(20 * time.Millisecond)
+		select {
+		case <-waitCtx.Done():
+			timer.Stop()
+			return nil, oauthProtected()
+		case <-timer.C:
+		}
+	}
+}
+
+func (api *OAuthRefreshAPI) refreshOpenAIDurable(ctx context.Context, account *Account, executor OAuthRefreshExecutor, window time.Duration) (*OAuthRefreshResult, error) {
+	repo, ok := api.accountRepo.(OpenAIOAuthDurableRepository)
+	if !ok {
+		return nil, oauthProtected()
+	}
+	key := executor.CacheKey(account)
+	mu := api.getLocalLock(key)
+	if err := mu.Lock(ctx); err != nil {
+		return nil, oauthProtected()
+	}
+	defer mu.Unlock()
+	// This lease reduces cache churn only. Neither its success, contention, nor
+	// failure grants permission to consume a refresh token.
+	if cache, ok := api.tokenCache.(OAuthOwnedLeaseCache); ok {
+		owner, err := cache.AcquireOAuthRefreshLease(ctx, key, api.lockTTL)
+		if err == nil && owner != "" {
+			defer func() {
+				cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), 2*time.Second)
+				defer cancel()
+				_ = cache.ReleaseOAuthRefreshLease(cleanup, key, owner)
+			}()
+		}
+	}
+	fresh, pending, err := repo.LoadOAuthState(ctx, account.ID)
+	if err != nil || !openAIAccountAdmitted(ctx, fresh) {
+		return nil, oauthProtected()
+	}
+	if pending {
+		return api.openAIClaimContended(ctx, fresh)
+	}
+	if !executor.CanRefresh(fresh) {
+		return nil, oauthProtected()
+	}
+	if !executor.NeedsRefresh(fresh, window) {
+		return &OAuthRefreshResult{Account: fresh}, nil
+	}
+	var random [24]byte
+	if _, err := rand.Read(random[:]); err != nil {
+		return nil, oauthProtected()
+	}
+	owner := hex.EncodeToString(random[:])
+	claimed, err := repo.ClaimOAuthRefresh(ctx, fresh, owner)
+	if err != nil {
+		return nil, oauthProtected()
+	}
+	if !claimed {
+		current, pending, readErr := repo.LoadOAuthState(ctx, fresh.ID)
+		if readErr != nil || !openAIAccountAdmitted(ctx, current) {
+			return nil, oauthProtected()
+		}
+		if pending {
+			return api.openAIClaimContended(ctx, current)
+		}
+		// A reconnect/another completion won before claim. Return its row;
+		// this invocation never retries the issuer with its old snapshot.
+		return &OAuthRefreshResult{Account: current}, nil
+	}
+	attempt := snapshotOAuthRefreshAccount(fresh)
+	issuerCtx := context.WithValue(ctx, oauthClaimContextKey{}, oauthClaimContext{id: fresh.ID, owner: owner})
+	credentials, issuerErr := executor.Refresh(issuerCtx, fresh)
+	terminal := isInvalidGrantError(issuerErr)
+	if issuerErr != nil && !terminal || credentials == nil && !terminal {
+		// Includes timeout/transport failure: consumption is unknown. Never
+		// release or expire the durable claim, and never enter issuer retries.
+		return &OAuthRefreshResult{Account: attempt}, oauthProtected()
+	}
+	// Persist an already returned result even after request cancellation. A
+	// bounded independent reread reconciles a lost completion acknowledgement.
+	cleanup, cancel := context.WithTimeout(context.WithoutCancel(ctx), 2*time.Second)
+	defer cancel()
+	current, applied, err := repo.CompleteOAuthRefresh(cleanup, attempt, owner, credentials, terminal)
+	if err != nil || current == nil {
+		return nil, oauthProtected()
+	}
+	if cache, ok := api.tokenCache.(OAuthRevisionTokenCache); ok {
+		_ = cache.DeleteOAuthAccessToken(cleanup, key, OAuthRevision(current))
+	}
+	if !applied {
+		if !openAIAccountAdmitted(ctx, current) {
+			return nil, oauthProtected()
+		}
+		return &OAuthRefreshResult{Account: current}, nil
+	}
+	if terminal {
+		return &OAuthRefreshResult{Account: current}, &accountPermanentRefreshError{
+			err: errors.New("OpenAI OAuth invalid_grant"), persistentlyBlocked: true,
+		}
+	}
+	if !openAIAccountAdmitted(ctx, current) {
+		return nil, oauthProtected()
+	}
+	return &OAuthRefreshResult{Refreshed: true, NewCredentials: current.Credentials, Account: current}, nil
+}
+
+func (api *OAuthRefreshAPI) openAIClaimContended(ctx context.Context, account *Account) (*OAuthRefreshResult, error) {
+	// The observer is an actual durable repository outcome, not a lease hint.
+	slog.Info("oauth_refresh.pg_claim_contended", "account_id", account.ID)
+	if !isOAuthRefreshRequestPath(ctx) {
+		return &OAuthRefreshResult{LockHeld: true, Account: account}, nil
+	}
+	current, err := loadOpenAIUsableAccount(ctx, api.accountRepo, account.ID)
+	if err != nil {
+		return nil, err
+	}
+	return &OAuthRefreshResult{Account: current}, nil
+}
+
+// Manual refresh uses the same account claim/completion, and returns its durable
+// row directly. It must never pass rotated credentials into a later admin PUT.
+func RefreshOpenAIAccount(ctx context.Context, repo AccountRepository, oauth *OpenAIOAuthService, account *Account) (*Account, error) {
+	if repo == nil || oauth == nil || account == nil {
+		return nil, oauthProtected()
+	}
+	// Explicit manual intent differs from rotating refresh eligibility.
+	durable, ok := repo.(OpenAIOAuthDurableRepository)
+	if !ok {
+		return nil, oauthProtected()
+	}
+	fresh, pending, err := durable.LoadOAuthState(ctx, account.ID)
+	if err != nil || pending || !openAIOAuthEligible(fresh) {
+		return nil, oauthProtected()
+	}
+	if fresh.IsOpenAIPersonalAccessToken() || strings.TrimSpace(fresh.GetOpenAIRefreshToken()) == "" {
+		saver, ok := repo.(OAuthValidationRepository)
+		if !ok {
+			return nil, oauthProtected()
+		}
+		credentials, err := NewOpenAITokenRefresher(oauth, repo).Refresh(ctx, fresh)
+		if err != nil {
+			return nil, err
+		}
+		return saver.SaveOAuthValidation(ctx, fresh, credentials)
+	}
+	api := NewOAuthRefreshAPI(repo, nil)
+	result, err := api.RefreshIfNeeded(withOAuthRefreshRequestPath(ctx), account, NewOpenAITokenRefresher(oauth, repo), time.Duration(1<<63-1))
+	if err != nil {
+		return nil, err
+	}
+	return result.Account, nil
+}
+
+type OAuthAccountRevisionRepository interface {
+	OAuthAccountRevision(context.Context, int64) (string, error)
+}
+
+func deleteOAuthSchedulerAccount(ctx context.Context, cache SchedulerCache, repo AccountRepository, id int64) error {
+	if revisions, ok := repo.(OAuthAccountRevisionRepository); ok {
+		revision, err := revisions.OAuthAccountRevision(ctx, id)
+		if err != nil {
+			return err
+		}
+		if versioned, ok := cache.(OAuthRevisionSchedulerCache); ok && revision != "" {
+			return versioned.DeleteOAuthAccount(ctx, id, revision)
+		}
+	}
+	return cache.DeleteAccount(ctx, id)
+}
+
+func oauthCredentialIntent(credentials map[string]any) map[string]bool {
+	fields := make(map[string]bool, len(credentials))
+	for key, value := range credentials {
+		if text, ok := value.(string); ok && strings.TrimSpace(text) == "" {
+			continue
+		}
+		if value != nil {
+			fields[key] = true
+		}
+	}
+	return fields
+}
+
+// Scheduling admission never waits on a pending owner or trusts a cached
+// lifecycle. Final bearer selection independently validates again.
+func admitOpenAISelection(ctx context.Context, repo AccountRepository, account *Account) (*Account, error) {
+	if account == nil {
+		return nil, oauthProtected()
+	}
+	if account.Platform != PlatformOpenAI || account.Type != AccountTypeOAuth {
+		return account, nil
+	}
+	durable, ok := repo.(OpenAIOAuthDurableRepository)
+	if !ok {
+		return nil, oauthProtected()
+	}
+	current, pending, err := durable.LoadOAuthState(ctx, account.ID)
+	if err != nil || pending || !current.IsSchedulable() {
+		return nil, oauthProtected()
+	}
+	if current.IsCredentialShadow() && current.ParentAccountID != nil {
+		parent, pending, err := durable.LoadOAuthState(ctx, *current.ParentAccountID)
+		if err != nil || pending || !parent.IsCredentialUsableForShadow() {
+			return nil, oauthProtected()
+		}
+	}
+	return current, nil
+}
+
+type OAuthValidationRepository interface {
+	SaveOAuthValidation(context.Context, *Account, map[string]any) (*Account, error)
+}
+
+// Deep-copy only the serialized account document. Never change a cached/shared
+// account pointer while binding request credentials, routing or parent intent.
+func cloneOAuthExecutionAccount(a *Account) (*Account, error) {
+	payload, err := json.Marshal(a)
+	if err != nil {
+		return nil, oauthProtected()
+	}
+	var result Account
+	if json.Unmarshal(payload, &result) != nil {
+		return nil, oauthProtected()
+	}
+	return &result, nil
+}
