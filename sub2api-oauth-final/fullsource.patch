+// Admin PUTs express field intent against a remembered DB snapshot. Under the
+// existing short edit transaction lock, apply only that intent to the current
+// row so a stale disable cannot write back pre-rotation credentials/status.
+func rebaseOAuthAccountEdit(ctx context.Context, client *dbent.Client, a *service.Account) error {
+	rows, err := client.QueryContext(ctx, `SELECT id FROM accounts WHERE id=$1 AND deleted_at IS NULL FOR UPDATE`, a.ID)
+	if err != nil {
+		return err
+	}
+	found := rows.Next()
+	rows.Close()
+	if !found {
+		return service.ErrAccountNotFound
