+// OpenAICapabilityProbeDisabled reads trusted account configuration only.
+// A missing, false or non-boolean value keeps the existing probe behavior.
+func OpenAICapabilityProbeDisabled(account *Account) bool {
+	if account == nil || account.Platform != PlatformOpenAI || account.Type != AccountTypeAPIKey {
+		return false
+	}
+	disabled, _ := account.Extra["openai_disable_capability_probe"].(bool)
+	return disabled
+}
