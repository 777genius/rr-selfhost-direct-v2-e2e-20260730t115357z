+//go:build unit
+
+package service
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCapabilityProbeServiceNoEffects(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "default positive control", true: "disabled"}[disabled], func(t *testing.T) {
+			account := Account{
+				ID: 96, Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+				Status: StatusDisabled, Schedulable: false,
+				Credentials: map[string]any{"api_key": "inert-test-key", "base_url": "https://synthetic.invalid/v1"},
+				Extra:       map[string]any{"openai_disable_capability_probe": disabled},
+			}
+			updates := make(chan map[string]any, 2)
+			repo := &snapshotUpdateAccountRepo{
+				stubOpenAIAccountRepo: stubOpenAIAccountRepo{accounts: []Account{account}},
+				updateExtraCalls:      updates,
+			}
+			upstream := &httpUpstreamRecorder{resp: &http.Response{
+				StatusCode: http.StatusOK, Header: make(http.Header),
+				Body: io.NopCloser(strings.NewReader(`{"output":[{"type":"function_call","name":"probe_ping"}]}`)),
+			}}
+			svc := NewAccountTestService(repo, nil, nil, nil, nil, upstream, &config.Config{}, nil)
+			svc.ProbeOpenAIAPIKeyResponsesSupport(context.Background(), account.ID)
+			want := 1
+			if disabled {
+				want = 0
+			}
+			require.Len(t, upstream.requests, want)
+			require.Len(t, updates, want)
+			require.Equal(t, map[string]any{"openai_disable_capability_probe": disabled}, repo.accounts[0].Extra)
+		})
+	}
+}
+
+func TestDuplicateAccountPreservesTrustedCapabilityProbeDisable(t *testing.T) {
+	repo := newDuplicateAccountRepoStub()
+	svc := &adminServiceImpl{accountRepo: repo, accountDuplicateRepo: repo}
+	source := &Account{
+		Name: "template", Platform: PlatformOpenAI, Type: AccountTypeAPIKey,
+		Credentials: map[string]any{"api_key": "inert-test-key"},
+		Extra:       map[string]any{"openai_disable_capability_probe": true},
+	}
+	require.NoError(t, repo.Create(context.Background(), source))
+	duplicate, err := svc.DuplicateAccount(context.Background(), source.ID, "admin:96", "copy-template")
+	require.NoError(t, err)
+	require.Equal(t, true, duplicate.Extra["openai_disable_capability_probe"])
+	stored, err := repo.GetByID(context.Background(), duplicate.ID)
+	require.NoError(t, err)
+	require.Equal(t, true, stored.Extra["openai_disable_capability_probe"])
+	require.False(t, duplicate.Schedulable)
+	duplicate.Extra["openai_disable_capability_probe"] = false
+	require.Equal(t, true, source.Extra["openai_disable_capability_probe"], "copy must not alias source Extra")
+}
