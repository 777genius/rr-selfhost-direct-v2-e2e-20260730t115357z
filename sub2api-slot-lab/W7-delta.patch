+export async function login(c, body, io = {}) {
+  const now = io.mono ?? mono, pause = io.sleep ?? sleep, send = io.fetch ?? globalThis.fetch;
+  const deadline = Math.min(c.deadline, c.supervisor_deadline ?? Infinity);
+  const encoded = JSON.stringify(body);
+  for (let attempt = 0; attempt < 2; attempt++) {
+    must(deadline - now() >= responseBudget, 'BATCH_DEADLINE');
+    const r = await send(`${c.engine_url}/api/v1/auth/login`, { method: 'POST',
+      headers: { 'content-type': 'application/json', authorization: `Bearer ${c.admin_bearer}` },
+      body: encoded, redirect: 'error', signal: AbortSignal.timeout(responseBudget) });
+    must(now() < deadline, 'BATCH_DEADLINE');
+    must(r.ok || (r.status === 429 && attempt === 0), 'CONTROL_OR_ADMIN_REJECTED');
+    const bytes = await r.arrayBuffer(); must(bytes.byteLength <= 2 * MiB, 'CONTROL_OR_ADMIN_LIMIT');
+    must(now() < deadline, 'BATCH_DEADLINE');
+    const data = JSON.parse(Buffer.from(bytes));
+    must(data.code === undefined || data.code === 0, 'ADMIN_API_REJECTED');
+    if (r.ok) return data.data ?? data;
+    const header = r.headers.get('retry-after');
+    must(typeof header === 'string' && /^(?:[1-9]|[1-5][0-9]|60)$/.test(header) &&
+      data.error === 'rate limit exceeded' && data.message === 'Too many requests, please try again later',
+      'CONTROL_OR_ADMIN_REJECTED');
+    const wait = Number(header) * 1000;
+    must(deadline - now() >= wait + responseBudget, 'BATCH_DEADLINE');
+    const until = now() + wait;
+    await pause(wait);
+    must(now() >= until && deadline - now() >= responseBudget, 'BATCH_DEADLINE');
+  }
+}
