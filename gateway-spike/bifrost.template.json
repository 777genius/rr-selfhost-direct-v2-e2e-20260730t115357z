{
  "client": {
    "enable_logging": false,
    "disable_content_logging": true,
    "enforce_auth_on_inference": true,
    "max_request_body_size_mb": 2
  },
  "providers": {
    "mimo-responses": {
      "keys": [],
      "network_config": {
        "base_url": "https://token-plan-sgp.xiaomimimo.com",
        "default_request_timeout_in_seconds": 120,
        "max_retries": 0,
        "stream_idle_timeout_in_seconds": 45
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "is_key_less": false,
        "allowed_requests": {
          "responses": true,
          "responses_stream": true
        },
        "request_path_overrides": {
          "responses": "/v1/responses",
          "responses_stream": "/v1/responses"
        }
      },
      "concurrency_and_buffer_size": {
        "concurrency": 2,
        "buffer_size": 4
      }
    },
    "openrouter-responses": {
      "keys": [],
      "network_config": {
        "base_url": "https://openrouter.ai",
        "default_request_timeout_in_seconds": 120,
        "max_retries": 0,
        "stream_idle_timeout_in_seconds": 45
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "is_key_less": false,
        "allowed_requests": {
          "responses": true,
          "responses_stream": true
        },
        "request_path_overrides": {
          "responses": "/api/v1/responses",
          "responses_stream": "/api/v1/responses"
        }
      },
      "concurrency_and_buffer_size": {
        "concurrency": 2,
        "buffer_size": 4
      }
    },
    "mimo-messages": {
      "keys": [],
      "network_config": {
        "base_url": "https://token-plan-sgp.xiaomimimo.com",
        "default_request_timeout_in_seconds": 120,
        "max_retries": 0,
        "stream_idle_timeout_in_seconds": 45
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "is_key_less": false,
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        },
        "request_path_overrides": {
          "chat_completion": "/anthropic/v1/messages",
          "chat_completion_stream": "/anthropic/v1/messages",
          "responses": "/anthropic/v1/messages",
          "responses_stream": "/anthropic/v1/messages"
        }
      },
      "concurrency_and_buffer_size": {
        "concurrency": 2,
        "buffer_size": 4
      }
    }
  },
  "governance": {
    "auth_config": {
      "is_enabled": true,
      "admin_username": "env.BIFROST_ADMIN_USERNAME",
      "admin_password": "env.BIFROST_ADMIN_PASSWORD",
      "disable_auth_on_inference": false
    }
  }
}
