+			var body *rrNativeBody
+			select {
+			case body = <-base.body:
+			case <-time.After(time.Second):
+				t.Fatal("missing transport body")
+			}
+			var failedAt time.Time
+			select {
+			case failedAt = <-writer.failed:
+			case <-time.After(3 * time.Second):
+				t.Fatal("enabled heartbeat never attempted a write")
+			}
+			deadline := failedAt.Add(rrNativeCancelOracle)
+			if ctx.Err() != nil {
+				t.Fatal("independent request context canceled before writer failure")
+			}
+			if optIn {
+				got := rrNativeGapResult(t, result, deadline)
+				var retry *UpstreamFailoverError
+				if got.err == nil || errors.As(got.err, &retry) || got.known || got.input != 0 || got.output != 0 {
+					t.Fatalf("heartbeat failure lost incomplete/unknown outcome: %+v", got)
+				}
+				rrNativeGapClosed(t, body, deadline)
+				rrNativeWait(t, canceled, time.Until(deadline), "upstream canceled by writer failure")
+				rrNativeWait(t, returned, time.Until(deadline), "upstream returned")
+			} else {
+				select {
+				case got := <-result:
+					t.Fatalf("default drain exited before release: %+v", got)
+				case <-body.closed:
+					t.Fatal("default heartbeat failure closed the held body")
+				case <-canceled:
+					t.Fatal("default heartbeat failure canceled upstream")
+				case <-time.After(time.Until(deadline)):
+				}
+				if body.active.Load() == 0 {
+					t.Fatal("default no longer draining the held real Read")
+				}
+				unblock()
+				got := rrNativeGapResult(t, result, time.Now().Add(rrNativeCancelOracle))
+				if got.err != nil || !got.known || got.input != 17 || got.output != 9 {
+					t.Fatalf("default final drain changed: %+v", got)
+				}
+				rrNativeGapClosed(t, body, time.Now().Add(rrNativeCancelOracle))
+			}
+			if ctx.Err() != nil || effects.Load() != 1 || base.attempts.Load() != 1 {
+				t.Fatal("writer failure canceled independent context or caused another dispatch")
+			}
+		})
+	}
+}
