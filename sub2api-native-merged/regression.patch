+func TestNativeAPIKeyCancellationUncertainTransportDoesNotRetry(t *testing.T) {
+	for _, route := range []string{"responses", "anthropic", "native-messages"} {
+		t.Run(route, func(t *testing.T) {
+			var attempts atomic.Int64
