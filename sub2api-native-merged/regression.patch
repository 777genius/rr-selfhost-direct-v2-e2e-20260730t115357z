+		if !errors.Is(got.err, context.Canceled) || effects.Load() != 1 {
+			t.Fatalf("default retry cancellation behavior changed: %+v", got)
+		}
+	} else if got.err == nil || !errors.As(got.err, &retry) || got.known || effects.Load() != 1 || base.attempts.Load() != 1 {
+		t.Fatalf("complete/default HTTP failover changed: %+v effects=%d", got, effects.Load())
+	}
+	rrNativeGapClosed(t, body, deadline)
+	if mode == "held-cancel" && optIn {
+		rrNativeWait(t, canceled, time.Until(deadline), "held HTTP body upstream canceled")
+		rrNativeWait(t, returned, time.Until(deadline), "held HTTP body upstream returned")
+	}
+}
