+// A complete compact recovery trigger inside an incomplete HTTP envelope must
+// never authorize recovery. Complete/default controls execute the existing
+// configured fallback on exactly the same bytes and request boundary.
+func TestNativeAPIKeyCancellationHTTPBodyCompactRecovery(t *testing.T) {
+	for _, truncated := range []bool{false, true} {
+		for _, optIn := range []bool{false, true} {
+			t.Run(fmt.Sprintf("truncated-%t/opt-in-%t", truncated, optIn), func(t *testing.T) {
+				request := bytes.Replace(rrNativeRequest("responses"), []byte(`"input":[`), []byte(`"input":[{"type":"compaction_trigger"},`), 1)
+				payload := `{"error":{"code":"context_length_exceeded","message":"maximum context length exceeded"}}`
+				var effects atomic.Int64
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					wire, err := io.ReadAll(r.Body)
+					if err != nil || !bytes.Contains(wire, []byte("9007199254740993")) || !bytes.Contains(wire, []byte("rs_mimo")) {
+						t.Errorf("protected compact request changed: %v", err)
+					}
+					if effects.Add(1) == 1 {
+						w.Header().Set("Content-Type", "application/json")
+						length := len(payload)
+						if truncated {
+							length += 64
+						}
+						w.Header().Set("Content-Length", fmt.Sprint(length))
+						w.WriteHeader(http.StatusServiceUnavailable)
+						_, _ = io.WriteString(w, payload)
+						return
+					}
+					if !bytes.Contains(wire, []byte(`"model":"fallback-compact"`)) {
+						t.Errorf("configured compact fallback not used: %s", wire)
+					}
+					w.Header().Set("Content-Type", "text/event-stream")
+					ack, terminal := rrNativeFrames("responses")
+					_, _ = io.WriteString(w, ack+terminal)
+				}))
+				t.Cleanup(server.Close)
+				address, _ := url.Parse(server.URL)
+				u := &rrNativeTransport{client: server.Client(), target: address, body: make(chan *rrNativeBody, 4)}
+				c, _ := gin.CreateTestContext(httptest.NewRecorder())
+				c.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", bytes.NewReader(request))
+				MarkOpenAINativeCompactionV2(c)
+				cfg := &config.Config{}
+				cfg.Gateway.OpenAICompactModel = "fallback-compact"
+				s := &OpenAIGatewayService{cfg: cfg, httpUpstream: u}
+				res, err := s.forwardOpenAIPassthrough(context.Background(), c, rrNativeAccount("responses", optIn), request, request, "mimo-v2.6-pro", false, nil, true, time.Now())
+				if optIn && truncated {
+					var retry *UpstreamFailoverError
+					if res != nil || !errors.Is(err, io.ErrUnexpectedEOF) || errors.As(err, &retry) || effects.Load() != 1 || u.attempts.Load() != 1 {
+						t.Fatalf("uncertain compact rejection authorized recovery: res=%+v err=%v effects=%d", res, err, effects.Load())
+					}
+				} else if err != nil || res == nil || res.Usage.InputTokens != 17 || res.Usage.OutputTokens != 9 || effects.Load() != 2 || u.attempts.Load() != 2 {
+					t.Fatalf("complete/default compact handling changed: res=%+v err=%v effects=%d", res, err, effects.Load())
+				}
+				for len(u.body) > 0 {
+					rrNativeGapClosed(t, <-u.body, time.Now().Add(rrNativeCancelOracle))
+				}
+			})
+		}
+	}
