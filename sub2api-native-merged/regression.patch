+func TestNativeAPIKeyCancellationPolicy(t *testing.T) {
+	for _, value := range []any{nil, false, "true", 1, []any{true}, map[string]any{"enabled": true}} {
+		if rrNativeAccount("responses", value).CancelsNativeAPIKeyOnDisconnect() {
+			t.Fatalf("untrusted/coerced policy enabled: %#v", value)
