+
+// Failure oracle, defined before executing scenarios: a held httptest upstream
+// must observe Request.Context cancellation and return within 1.25s of the
+// downstream cancel when trusted opt-in is true. A default account must remain
+// active throughout that SAME interval and finish only after explicit release.
+// Count real dispatched attempts, real body closes, and active real Reads.
+const rrNativeCancelOracle = 1250 * time.Millisecond
+
+type rrNativeBody struct {
+	io.ReadCloser
+	active atomic.Int64
+	closed chan struct{}
+	once   sync.Once
+}
+
+func (b *rrNativeBody) Read(p []byte) (int, error) {
+	b.active.Add(1)
+	defer b.active.Add(-1)
+	return b.ReadCloser.Read(p)
+}
+
+func (b *rrNativeBody) Close() error {
+	err := b.ReadCloser.Close()
+	b.once.Do(func() { close(b.closed) })
+	return err
+}
+
+// This is a real http.Client transport adapter, not a canned response double.
+// Only the destination is redirected to this test's actual httptest server.
+type rrNativeTransport struct {
+	client   *http.Client
+	target   *url.URL
+	attempts atomic.Int64
+	body     chan *rrNativeBody
+}
+
+func (u *rrNativeTransport) Do(req *http.Request, _ string, _ int64, _ int) (*http.Response, error) {
+	u.attempts.Add(1)
+	forward := req.Clone(req.Context())
+	destination := *req.URL
+	destination.Scheme, destination.Host = u.target.Scheme, u.target.Host
+	forward.URL, forward.Host = &destination, u.target.Host
+	resp, err := u.client.Do(forward)
+	if err == nil {
+		body := &rrNativeBody{ReadCloser: resp.Body, closed: make(chan struct{})}
+		resp.Body = body
+		u.body <- body
+	}
+	return resp, err
+}
+
+func (u *rrNativeTransport) DoWithTLS(req *http.Request, proxy string, id int64, concurrency int, _ *tlsfingerprint.Profile) (*http.Response, error) {
+	return u.Do(req, proxy, id, concurrency)
+}
+
+type rrNativeWriter struct {
+	gin.ResponseWriter
+	ack    chan struct{}
+	once   sync.Once
+	fail   bool
+	failAt atomic.Int64
+}
+
+func (w *rrNativeWriter) Flush() {
+	w.ResponseWriter.Flush()
+	w.once.Do(func() { close(w.ack) })
+}
+
+func (w *rrNativeWriter) Write(p []byte) (int, error) {
+	if w.fail {
+		w.failAt.CompareAndSwap(0, time.Now().UnixNano())
+		return 0, io.ErrClosedPipe
+	}
+	return w.ResponseWriter.Write(p)
+}
+
+func (w *rrNativeWriter) WriteString(p string) (int, error) { return w.Write([]byte(p)) }
+
+type rrNativeResult struct {
+	known      bool
+	input      int
+	output     int
+	disconnect bool
+	err        error
+}
+
+func rrNativeAccount(route string, enabled any) *Account {
+	a := &Account{ID: 919, Name: "native-cancel-test", Type: AccountTypeAPIKey,
+		Platform: PlatformOpenAI, Concurrency: 1, Credentials: map[string]any{"api_key": "synthetic"},
+		Extra: map[string]any{NativeAPIKeyCancelOnDisconnectExtraKey: enabled,
+			"openai_preserve_compatible_reasoning": true, "openai_responses_mode": "force_responses", "openai_passthrough": true}}
+	if route == "anthropic" {
+		a.Platform = PlatformAnthropic
+		a.Extra["anthropic_passthrough"] = true
+	}
+	if route == "native-messages" {
+		a.Platform = PlatformKimi
+		a.Credentials["api_protocol"] = APIProtocolAnthropic
+	}
+	return a
+}
+
+func rrNativeRequest(route string) []byte {
+	if route == "responses" {
+		return []byte(`{"model":"mimo-v2.6-pro","stream":true,"native_api_key_cancel_on_disconnect":true,"input":[{"type":"reasoning","id":"rs_mimo","content":[{"type":"reasoning_text","text":"opaque"}],"opaque":9007199254740993},{"type":"message","role":"user","content":"hi"}]}`)
+	}
+	return []byte(`{"model":"k3","max_tokens":32,"stream":true,"native_api_key_cancel_on_disconnect":true,"messages":[{"role":"user","content":"hi"}],"metadata":{"protected":9007199254740993}}`)
+}
+
+func rrNativeFrames(route string) (string, string) {
+	if route == "responses" {
+		return "data: {\"type\":\"response.output_text.delta\",\"delta\":\"ACK\",\"response\":{\"usage\":{\"input_tokens\":17,\"output_tokens\":2}}}\n\n",
+			"data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_cancel\",\"status\":\"completed\",\"usage\":{\"input_tokens\":17,\"output_tokens\":9}}}\n\n"
+	}
+	return "event: message_start\ndata: {\"type\":\"message_start\",\"message\":{\"id\":\"msg_cancel\",\"usage\":{\"input_tokens\":17,\"output_tokens\":0}}}\n\nevent: message_delta\ndata: {\"type\":\"message_delta\",\"usage\":{\"output_tokens\":2}}\n\n",
+		"event: message_delta\ndata: {\"type\":\"message_delta\",\"usage\":{\"output_tokens\":9}}\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"}\n\n"
+}
+
+// Decode received wire frames independently of the production accounting
+// parser. First-frame Flush, headers, and future final usage are insufficient.
+func rrNativeAssertWireUsage(frames string) error {
+	input, output := 0, 0
+	for _, line := range strings.Split(frames, "\n") {
+		if !strings.HasPrefix(line, "data: ") {
+			continue
+		}
+		var event struct {
+			Type  string `json:"type"`
+			Usage struct {
+				Output int `json:"output_tokens"`
+			} `json:"usage"`
+			Message struct {
+				Usage struct {
+					Input int `json:"input_tokens"`
+				} `json:"usage"`
+			} `json:"message"`
+			Response struct {
+				Usage struct {
+					Input  int `json:"input_tokens"`
+					Output int `json:"output_tokens"`
+				} `json:"usage"`
+			} `json:"response"`
+		}
+		if err := json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &event); err != nil {
+			return err
+		}
+		switch event.Type {
+		case "message_start":
+			input = event.Message.Usage.Input
+		case "message_delta":
+			output = event.Usage.Output
+		case "response.output_text.delta":
+			input, output = event.Response.Usage.Input, event.Response.Usage.Output
+		default:
+			return fmt.Errorf("unexpected/terminal event before cancel: %s", event.Type)
+		}
+	}
+	if input != 17 || output != 2 {
+		return fmt.Errorf("wire partial usage not observed: %d/%d", input, output)
+	}
+	return nil
+}
