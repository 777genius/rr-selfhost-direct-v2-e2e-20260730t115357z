+func rrNativeForward(ctx context.Context, c *gin.Context, route string, a *Account, u HTTPUpstream, body []byte) rrNativeResult {
+	cfg := &config.Config{}
+	if route == "anthropic" {
+		s := &GatewayService{cfg: cfg, httpUpstream: u}
+		res, err := s.forwardAnthropicAPIKeyPassthrough(ctx, c, a, body, "k3", "k3", true, time.Now())
+		if res == nil {
+			return rrNativeResult{err: err}
+		}
+		return rrNativeResult{true, res.Usage.InputTokens, res.Usage.OutputTokens, res.ClientDisconnect, err}
+	}
+	s := &OpenAIGatewayService{cfg: cfg, httpUpstream: u}
+	var res *OpenAIForwardResult
+	var err error
+	if route == "native-messages" {
+		res, err = s.forwardAnthropicViaNativeAnthropicEndpoint(ctx, c, a, body, "")
+	} else {
+		res, err = s.forwardOpenAIPassthrough(ctx, c, a, body, body, "mimo-v2.6-pro", false, nil, true, time.Now())
+	}
+	if res == nil {
+		return rrNativeResult{err: err}
+	}
+	return rrNativeResult{true, res.Usage.InputTokens, res.Usage.OutputTokens, res.ClientDisconnect, err}
+}
+
+func rrNativeWait(t *testing.T, ch <-chan struct{}, timeout time.Duration, label string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(timeout):
+		t.Fatalf("%s was not observed within %s", label, timeout)
+	}
+}
