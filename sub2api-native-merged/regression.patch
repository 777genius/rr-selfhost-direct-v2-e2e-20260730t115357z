+	payload := `{"error":{"type":"invalid_request_error","code":"invalid_encrypted_content","message":"opaque input rejected"}}`
+	if mode == "over-limit" || mode == "over-limit-truncated" || mode == "over-limit-400" {
+		payload += strings.Repeat(" ", max(int(gatewayUpstreamErrorBodyReadLimit), int(openAIUpstreamErrorBodyReadLimit))+1)
+	}
+	status := http.StatusServiceUnavailable
+	if mode == "complete-400" || mode == "over-limit-400" {
+		status = http.StatusBadRequest
+	}
+	release, returned, canceled := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var releaseOnce, returnOnce, cancelOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	var effects atomic.Int64
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer returnOnce.Do(func() { close(returned) })
+		wire, err := io.ReadAll(r.Body)
+		if err != nil || !bytes.Contains(wire, []byte("9007199254740993")) || (route == "responses" && !bytes.Contains(wire, []byte("rs_mimo"))) {
+			t.Errorf("full protected request not received before effect: %v", err)
+		}
+		attempt := effects.Add(1)
+		if sameAccountRetry && attempt > 1 {
+			w.Header().Set("Content-Type", "text/event-stream")
+			ack, terminal := rrNativeFrames(route)
+			_, _ = io.WriteString(w, ack+terminal)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		length := len(payload)
+		if mode == "over-limit-truncated" {
+			length += 64
+		}
+		w.Header().Set("Content-Length", fmt.Sprint(length))
+		w.WriteHeader(status)
+		if mode == "truncated" || mode == "held-cancel" {
+			_, _ = io.WriteString(w, payload[:12])
+			w.(http.Flusher).Flush()
+			if mode == "held-cancel" {
+				select {
+				case <-r.Context().Done():
+					cancelOnce.Do(func() { close(canceled) })
+					return
+				case <-release:
+					_, _ = io.WriteString(w, payload[12:])
+				}
+			}
+			return
+		}
+		_, _ = io.WriteString(w, payload)
+	}))
+	t.Cleanup(server.Close)
+	t.Cleanup(unblock)
+	address, _ := url.Parse(server.URL)
+	base := &rrNativeTransport{client: server.Client(), target: address, body: make(chan *rrNativeBody, 8)}
+	u := &rrNativeGapTransport{rrNativeTransport: base, entered: make(chan struct{})}
+	// The one-shot read barrier spans all responses, including a default retry.
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/"+route, bytes.NewReader(request)).WithContext(ctx)
+	a := rrNativeAccount(route, optIn)
+	if sameAccountRetry {
+		a.Credentials["custom_error_codes_enabled"] = true
+		a.Credentials["custom_error_codes"] = []any{float64(400)}
+	}
+	result := make(chan rrNativeResult, 1)
+	go func() { result <- rrNativeForward(ctx, c, route, a, u, request) }()
+	rrNativeWait(t, u.entered, 3*time.Second, "HTTP error body Read after whole-request effect")
+	var body *rrNativeBody
+	select {
+	case body = <-base.body:
+	case <-time.After(time.Second):
+		t.Fatal("missing HTTP error body")
+	}
+	deadline := time.Now().Add(rrNativeCancelOracle)
+	if mode == "held-cancel" {
+		cancel()
+		if !optIn {
+			select {
+			case got := <-result:
+				t.Fatalf("default held error read exited before release: %+v", got)
+			case <-body.closed:
+				t.Fatal("default held error body closed before release")
+			case <-canceled:
+				t.Fatal("default detached error body canceled")
+			case <-time.After(time.Until(deadline)):
+			}
+			if body.active.Load() == 0 {
+				t.Fatal("default held error Read is no longer active")
+			}
+			unblock()
+			deadline = time.Now().Add(rrNativeCancelOracle)
+		}
+	}
+	got := rrNativeGapResult(t, result, deadline)
+	var retry *UpstreamFailoverError
