+func TestNativeAPIKeyCancellationUsageFixture(t *testing.T) {
+	// W1 put output=2 only in message_start. The unchanged shared production
+	// parser reads input/cache there and output only in message_delta. This
+	// reproduces the exact 17/0 root receipt without a scheduling assumption.
+	legacy := `{"type":"message_start","message":{"usage":{"input_tokens":17,"output_tokens":2}}}`
+	usage := &ClaudeUsage{}
+	parseSSEUsagePassthrough(legacy, usage)
+	if usage.InputTokens != 17 || usage.OutputTokens != 0 {
+		t.Fatalf("original message_start accounting changed: %+v", usage)
+	}
+	for _, route := range []string{"anthropic", "native-messages"} {
+		partial, terminal := rrNativeFrames(route)
+		if err := rrNativeAssertWireUsage(partial); err != nil {
+			t.Fatal(err)
+		}
+		usage := &ClaudeUsage{}
+		for _, line := range strings.Split(partial, "\n") {
+			if data, ok := extractAnthropicSSEDataLine(line); ok {
+				parseSSEUsagePassthrough(data, usage)
+			}
+		}
+		if usage.InputTokens != 17 || usage.OutputTokens != 2 {
+			t.Fatalf("partial fixture not actually parsed: %+v", usage)
+		}
+		startOnly := strings.SplitN(partial, "event: message_delta", 2)[0]
+		if rrNativeAssertWireUsage(startOnly) == nil || rrNativeAssertWireUsage(partial+terminal) == nil {
+			t.Fatal("wire observation admits early acknowledgement or final usage")
+		}
+	}
+}
