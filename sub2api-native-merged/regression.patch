+func TestNativeAPIKeyCancellationAnthropicHTTPBodySameAccountRetry(t *testing.T) {
+	for _, mode := range []string{"truncated", "held-cancel", "complete-503"} {
+		for _, optIn := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/opt-in-%t", mode, optIn), func(t *testing.T) {
