+	close(after.release)
+	memoryAwait(t, done)
+	require.NoError(t, gotErr)
+	require.Equal(t, prefix+first+terminal, rec.Body.String())
+	require.Equal(t, 7, result.usage.InputTokens)
+	require.Equal(t, 5, result.usage.OutputTokens)
+}
