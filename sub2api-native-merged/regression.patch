+		}
+		if !errors.Is(got.err, cause) {
+			t.Fatalf("actual HTTP read/cancellation cause lost: %v", got.err)
+		}
+		if strings.Contains(got.err.Error(), "opaque") || strings.Contains(rec.Body.String(), payload[:12]) {
+			t.Fatal("incomplete upstream body exposed publicly")
+		}
+	} else if sameAccountRetry && mode != "held-cancel" {
+		if got.err != nil || !got.known || got.input != 17 || got.output != 9 || effects.Load() != 2 || base.attempts.Load() != 2 {
