+		if a.CancelsNativeAPIKeyOnDisconnect() {
+			t.Fatalf("subscription/non-API-key type opted in: %s", kind)
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		detached, _ := nativeAPIKeyUpstreamContext(ctx, a, true)
+		cancel()
+		if detached.Err() != nil {
+			t.Fatalf("subscription default drain changed: %s", kind)
+		}
+	}
+	for _, route := range []string{"responses", "anthropic", "native-messages"} {
+		a := rrNativeAccount(route, true)
+		if !a.CancelsNativeAPIKeyOnDisconnect() {
+			t.Fatal("trusted native account opt-in lost")
+		}
+		if route == "responses" && !a.PreservesCompatibleResponsesReasoning() {
+			t.Fatal("existing trusted reasoning policy lost")
+		}
+		ctx, cancel := context.WithCancel(context.Background())
+		on, _ := nativeAPIKeyUpstreamContext(ctx, a, true)
+		a.Extra[NativeAPIKeyCancelOnDisconnectExtraKey] = false
+		off, _ := nativeAPIKeyUpstreamContext(ctx, a, true)
+		cancel()
+		if on.Err() != context.Canceled || off.Err() != nil {
+			t.Fatal("native opt-in/default contexts reversed")
+		}
+	}
+}
