+func TestNativeAPIKeyCancellationRealTransport(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, route := range []string{"responses", "anthropic", "native-messages"} {
+		for _, phase := range []string{"before-headers", "before-ack", "after-ack"} {
+			for _, optIn := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/%s/opt-in-%t", route, phase, optIn), func(t *testing.T) {
+					rrNativeTransportCase(t, route, phase, optIn, false)
+				})
+			}
+		}
+	}
+}
+
+func rrNativeTransportCase(t *testing.T, route, phase string, optIn, failedWriter bool) {
+	t.Helper()
+	started, canceled, returned, release := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	var capacityRequests atomic.Int64
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	wire := make(chan []byte, 2)
+	ack, terminal := rrNativeFrames(route)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/capacity" {
+			capacityRequests.Add(1)
+			_, _ = io.WriteString(w, "healthy")
+			return
+		}
+		defer close(returned)
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read real forwarded request: %v", err)
+		}
+		wire <- body
+		close(started)
+		if phase != "before-headers" {
+			w.Header().Set("Content-Type", "text/event-stream")
+			w.WriteHeader(http.StatusOK)
+			if phase == "after-ack" {
+				_, _ = io.WriteString(w, ack)
+			}
+			w.(http.Flusher).Flush()
+		}
+		select {
+		case <-r.Context().Done():
+			close(canceled)
+			return
+		case <-release:
+			if phase == "before-headers" {
+				w.Header().Set("Content-Type", "text/event-stream")
+			}
+			if phase != "after-ack" {
+				_, _ = io.WriteString(w, ack)
+			}
+			_, _ = io.WriteString(w, terminal)
+		}
+	}))
+	t.Cleanup(server.Close)
+	t.Cleanup(unblock)
+	transport := &http.Transport{MaxConnsPerHost: 1}
+	t.Cleanup(transport.CloseIdleConnections)
+	address, _ := url.Parse(server.URL)
+	u := &rrNativeTransport{client: &http.Client{Transport: transport}, target: address, body: make(chan *rrNativeBody, 2)}
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	request := rrNativeRequest(route)
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest(http.MethodPost, "/v1/"+route, bytes.NewReader(request)).WithContext(ctx)
+	writer := &rrNativeWriter{ResponseWriter: c.Writer, ack: make(chan struct{}), fail: failedWriter}
+	c.Writer = writer
+	result := make(chan rrNativeResult, 1)
+	// The first Flush acknowledges message_start only. For after-ack, use a
+	// second real HTTP connection to observe the subsequent usage delta too.
+	var downstreamResult chan *http.Response
+	var downstreamErrors chan error
+	if phase == "after-ack" && !failedWriter {
+		downstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			wireContext, _ := gin.CreateTestContext(w)
+			wireContext.Request = r.WithContext(ctx)
+			wireContext.Writer = &rrNativeWriter{ResponseWriter: wireContext.Writer, ack: writer.ack}
+			result <- rrNativeForward(ctx, wireContext, route, rrNativeAccount(route, optIn), u, request)
+		}))
+		t.Cleanup(func() {
+			cancel()
+			unblock()
+			downstream.Close()
+		})
+		downstreamResult, downstreamErrors = make(chan *http.Response, 1), make(chan error, 1)
+		clientRequest, err := http.NewRequestWithContext(ctx, http.MethodPost, downstream.URL, bytes.NewReader(request))
+		if err != nil {
+			t.Fatal(err)
+		}
+		go func() {
+			resp, err := downstream.Client().Do(clientRequest)
+			if err != nil {
+				downstreamErrors <- err
+				return
+			}
+			downstreamResult <- resp
+		}()
+	} else {
+		go func() { result <- rrNativeForward(ctx, c, route, rrNativeAccount(route, optIn), u, request) }()
+	}
+	rrNativeWait(t, started, 3*time.Second, "real upstream request")
+	if body := <-wire; !bytes.Contains(body, []byte("9007199254740993")) || (route == "responses" && !bytes.Contains(body, []byte("rs_mimo"))) {
+		t.Fatalf("native protected fields changed: %s", body)
+	}
+	var acquiredBody *rrNativeBody
+	if phase != "before-headers" {
+		select {
+		case acquiredBody = <-u.body:
+		case <-time.After(3 * time.Second):
+			t.Fatal("real response headers/body not acquired before cancel")
+		}
+	}
+	if phase == "after-ack" && !failedWriter {
+		rrNativeWait(t, writer.ack, 3*time.Second, "first downstream frame acknowledgement")
+		var downstreamBody io.ReadCloser
+		select {
+		case resp := <-downstreamResult:
+			if resp.StatusCode != http.StatusOK {
+				t.Fatalf("downstream wire status: %d", resp.StatusCode)
+			}
+			downstreamBody = resp.Body
+		case err := <-downstreamErrors:
+			t.Fatalf("downstream wire request: %v", err)
+		case <-time.After(3 * time.Second):
+			t.Fatal("downstream wire headers not delivered")
+		}
+		t.Cleanup(func() { _ = downstreamBody.Close() })
+		wireAck := make(chan error, 1)
+		go func() {
+			observed := make([]byte, len(ack))
+			_, err := io.ReadFull(downstreamBody, observed)
+			if err == nil && string(observed) != ack {
+				err = fmt.Errorf("downstream usage frames differ: %q", observed)
+			}
+			if err == nil {
+				err = rrNativeAssertWireUsage(string(observed))
+			}
+			wireAck <- err
+		}()
+		select {
+		case err := <-wireAck:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("partial usage 17/2 not delivered on real downstream wire")
+		}
+		// Parsing precedes downstream writes in both production readers.
+		// Only complete receipt of these usage frames admits cancellation.
+		select {
+		case got := <-result:
+			t.Fatalf("forward returned before cancellation/release: %+v", got)
+		case <-returned:
+			t.Fatal("held upstream returned before usage observation barrier")
+		default:
+		}
+	}
+	if optIn && !failedWriter {
+		// MaxConnsPerHost=1 puts this actual request behind the held real request.
+		// A canceled waiter must never dispatch, and must not consume later capacity.
+		queued, cancelQueued := context.WithCancel(context.Background())
+		getConn := make(chan struct{})
+		queued = httptrace.WithClientTrace(queued, &httptrace.ClientTrace{GetConn: func(string) { close(getConn) }})
+		probe, _ := http.NewRequestWithContext(queued, http.MethodGet, server.URL+"/capacity", nil)
+		queueResult := make(chan error, 1)
+		go func() {
+			res, err := u.client.Do(probe)
+			if res != nil {
+				_ = res.Body.Close()
+			}
+			queueResult <- err
+		}()
+		rrNativeWait(t, getConn, time.Second, "real queued transport waiter")
+		cancelQueued()
+		select {
+		case err := <-queueResult:
+			if !errors.Is(err, context.Canceled) || capacityRequests.Load() != 0 {
+				t.Fatalf("queued cancel dispatched or did not clean up: %v", err)
+			}
+		case <-time.After(rrNativeCancelOracle):
+			t.Fatal("canceled real transport waiter remains queued")
+		}
+	}
+	start := time.Now()
+	if !failedWriter {
+		cancel()
+	}
+	if optIn {
+		rrNativeWait(t, canceled, rrNativeCancelOracle, "upstream canceled")
+		rrNativeWait(t, returned, rrNativeCancelOracle-time.Since(start), "upstream handler returned")
+	} else {
+		select {
+		case <-canceled:
+			t.Fatal("default billing drain was canceled")
+		case got := <-result:
+			t.Fatalf("default completed before held upstream release: %+v", got)
+		case <-time.After(rrNativeCancelOracle):
+		}
+		unblock()
+	}
+	var got rrNativeResult
+	select {
+	case got = <-result:
+	case <-time.After(rrNativeCancelOracle):
+		t.Fatal("forward or real body reader did not exit")
+	}
+	if failedWriter && writer.failAt.Load() > 0 {
+		start = time.Unix(0, writer.failAt.Load())
+	}
+	if optIn && time.Since(start) > rrNativeCancelOracle {
+		t.Fatalf("forward/reader exceeded 1.25s immediate-abort oracle: %s", time.Since(start))
+	}
+	if u.attempts.Load() != 1 {
+		t.Fatalf("unexpected second attempt: %d", u.attempts.Load())
+	}
+	if optIn {
+		if got.err == nil {
+			t.Fatal("partial cancellation was reported as success")
+		}
+		var retry *UpstreamFailoverError
+		if errors.As(got.err, &retry) {
+			t.Fatal("canceled or uncertain attempt permits handler retry")
+		}
+		if phase == "after-ack" && !failedWriter {
+			if !got.known || got.input != 17 || got.output != 2 || !got.disconnect {
+				t.Fatalf("observed partial usage lost or final usage manufactured: %+v", got)
+			}
+		} else if failedWriter {
+			// Anthropic's leading event: line can fail before its data: usage is
+			// read; Responses parses usage before its first downstream write.
+			if got.known && (got.input != 17 || got.output != 2 || !got.disconnect) {
+				t.Fatalf("writer failure manufactured or lost observed partial usage: %+v", got)
+			}
+		} else if got.known && (got.input != 0 || got.output != 0) {
+			t.Fatalf("usage invented before upstream evidence: %+v", got)
+		}
+	} else if got.err != nil || !got.known || got.input != 17 || got.output != 9 {
+		t.Fatalf("default final billing drain changed: %+v", got)
+	}
+	if acquiredBody == nil {
+		select {
+		case acquiredBody = <-u.body:
+		default:
+		}
+	}
+	if acquiredBody != nil {
+		rrNativeWait(t, acquiredBody.closed, rrNativeCancelOracle, "real response body Close")
+		if acquiredBody.active.Load() != 0 {
+			t.Fatal("blocked real transport Read remains after forward return")
+		}
+	} else {
+		if phase != "before-headers" {
+			t.Fatal("real response body was not acquired")
+		}
+	}
+	if optIn {
+		probeCtx, stop := context.WithTimeout(context.Background(), rrNativeCancelOracle)
+		defer stop()
+		probe, _ := http.NewRequestWithContext(probeCtx, http.MethodGet, server.URL+"/capacity", nil)
+		res, err := u.client.Do(probe)
+		if err != nil {
+			t.Fatalf("real transport capacity not reclaimed: %v", err)
+		}
+		defer res.Body.Close()
+		body, err := io.ReadAll(res.Body)
+		if err != nil || string(body) != "healthy" || capacityRequests.Load() != 1 {
+			t.Fatalf("transport connection/waiter cleanup health failed: %v", err)
+		}
+	}
+}
