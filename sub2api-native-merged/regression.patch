+func TestNativeAPIKeyCancellationHTTPBodyUncertainty(t *testing.T) {
+	for _, route := range []string{"responses", "anthropic", "native-messages"} {
+		for _, mode := range []string{"truncated", "held-cancel", "complete-503", "complete-400", "over-limit", "over-limit-truncated", "over-limit-400"} {
+			for _, optIn := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/%s/opt-in-%t", route, mode, optIn), func(t *testing.T) {
+					rrNativeHTTPBodyCase(t, route, mode, optIn, false)
+				})
+			}
+		}
+	}
+}
