@@ -0,0 +1,118 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+)
+
+// NativeAPIKeyCancelOnDisconnectExtraKey is trusted account configuration.
+// Only the three native HTTP passthrough call sites consume this policy.
+const NativeAPIKeyCancelOnDisconnectExtraKey = "native_api_key_cancel_on_disconnect"
+
+func (a *Account) CancelsNativeAPIKeyOnDisconnect() bool {
+	if a == nil || a.Type != AccountTypeAPIKey {
+		return false
+	}
+	enabled, ok := a.Extra[NativeAPIKeyCancelOnDisconnectExtraKey].(bool)
+	return ok && enabled
+}
+
+func nativeAPIKeyUpstreamContext(ctx context.Context, account *Account, stream bool) (context.Context, context.CancelFunc) {
+	if account.CancelsNativeAPIKeyOnDisconnect() && ctx != nil {
+		return ctx, func() {}
+	}
+	return detachStreamUpstreamContext(ctx, stream)
+}
+
+// Closing a net/http transport body interrupts a blocked Read. This also covers
+// direct response-handler callers whose body was opened with a detached context.
+func watchNativeAPIKeyDisconnect(ctx context.Context, account *Account, body io.ReadCloser) func() {
+	if !account.CancelsNativeAPIKeyOnDisconnect() || ctx == nil || body == nil {
+		return func() {}
+	}
+	stop := context.AfterFunc(ctx, func() { _ = body.Close() })
+	return func() { stop() }
+}
+
+// The caller owns done; the scanner owns exited and its pooled buffer. Never
+// return the scanner buffer to the pool before the real reader has exited.
+func finishNativeAPIKeyReader(account *Account, body io.ReadCloser, done chan struct{}, exited <-chan struct{}) error {
+	close(done)
+	if !account.CancelsNativeAPIKeyOnDisconnect() {
+		return nil
+	}
+	_ = body.Close()
+	timer := time.NewTimer(500 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-exited:
+		return nil
+	case <-timer.C:
+		return errors.New("native API-key reader did not exit within 500ms")
+	}
+}
+
+// A transport/stream failure after dispatch cannot prove absence of effects.
+// Keep existing error side effects, but prevent handler account-switch retries.
+func nativeAPIKeyNoRetryError(account *Account, err error) error {
+	if !account.CancelsNativeAPIKeyOnDisconnect() || err == nil {
+		return err
+	}
+	var failover *UpstreamFailoverError
+	if errors.As(err, &failover) {
+		return fmt.Errorf("native API-key attempt uncertain; retry suppressed: %v", err)
+	}
+	return err
+}
+
+// Retain the actual read cause for errors.Is without publishing arbitrary body,
+// URL, credential, or transport error text. This error never wraps a failover.
+type nativeAPIKeyHTTPBodyReadError struct{ cause error }
+
+func (e *nativeAPIKeyHTTPBodyReadError) Error() string {
+	return "native API-key HTTP error body incomplete; attempt uncertain; retry suppressed"
+}
+
+// Match the actual cause without exposing arbitrary transport types or retry
+// sentinels through errors.As. The retained cause is private.
+func (e *nativeAPIKeyHTTPBodyReadError) Is(target error) bool { return errors.Is(e.cause, target) }
+
+// Shared error readers deliberately retain their original signatures/defaults.
+// Only the three native opt-in routes establish certainty here, BEFORE handing
+// complete bytes to any existing status rejection, compact, or retry handler.
+// Retain only the existing bounded prefix. Drain the remainder without retaining
+// it so LimitReader EOF cannot hide a later actual read error. Complete large
+// rejections still enter the existing handlers with the same bounded bytes.
+func bufferNativeAPIKeyHTTPError(ctx context.Context, account *Account, resp *http.Response, limit int64) error {
+	if !account.CancelsNativeAPIKeyOnDisconnect() {
+		return nil
+	}
+	if resp == nil || resp.Body == nil {
+		return &nativeAPIKeyHTTPBodyReadError{cause: io.ErrUnexpectedEOF}
+	}
+	body := resp.Body
+	stop := watchNativeAPIKeyDisconnect(ctx, account, body)
+	data, readErr := io.ReadAll(io.LimitReader(body, limit))
+	if readErr == nil && int64(len(data)) == limit {
+		_, readErr = io.Copy(io.Discard, body)
+	}
+	stop()
+	_ = body.Close()
+	if ctx != nil && ctx.Err() != nil {
+		if readErr == nil {
+			readErr = ctx.Err()
+		} else {
+			readErr = errors.Join(readErr, ctx.Err())
+		}
+	}
+	if readErr != nil {
+		return &nativeAPIKeyHTTPBodyReadError{cause: readErr}
+	}
+	resp.Body = io.NopCloser(bytes.NewReader(data))
+	return nil
+}
